---
import type { Interview } from "../lib/content";
import { topics, cards } from "../lib/content";
import { published, crossCut } from "../lib/crosscut";
import { safeBody, appearances } from "../lib/cards";
import { resolveVideoSource } from "../lib/resolveVideoSource";

interface Props {
  interview: Interview;
}
const { interview } = Astro.props;
const source = resolveVideoSource(interview);

// The scrub track maps time to width. Until real durations arrive at
// transcode time (M3), the basis is the end of the last tagged segment.
const basis =
  interview.video.duration ??
  Math.max(...interview.segments.map((s) => s.end), ...interview.cards.map((c) => c.time), 1);

// Server-rendered spans keep the page meaningful without JavaScript;
// the client rebuilds the track when a placeholder stream rescales it.
const spans: { width: number; colour: string | null; label: string | null; active?: string }[] = [];
let cursor = 0;
for (const s of interview.segments) {
  if (s.start > cursor) spans.push({ width: ((s.start - cursor) / basis) * 100, colour: null, label: null });
  const t = topics.get(s.topicId);
  spans.push({ width: ((s.end - s.start) / basis) * 100, colour: t?.colour ?? "#666", label: t?.label ?? s.topicId });
  cursor = s.end;
}

const interviewTopics = [...new Set(interview.segments.map((s) => s.topicId))].map(
  (id) => topics.get(id)!,
);

// the same two doors as the cross-cut: every topic, and everyone
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const allTopicsWithFilm = [...topics.values()]
  .filter((t) => crossCut(t.slug).playable.length > 0)
  .sort((a, b) => a.label.localeCompare(b.label))
  .map((t) => ({ slug: t.slug, label: t.label }));
const mine = new Set(interview.segments.map((s) => s.topicId));
const everyone = published()
  .map((iv) => ({ slug: iv.slug, name: iv.interviewee.name }))
  .sort((a, b) => a.name.localeCompare(b.name));

const clientData = {
  source: source && { url: source.url, placeholder: source.placeholder },
  segments: interview.segments,
  cards: interview.cards,
  topics: Object.fromEntries(
    interviewTopics.map((t) => [t.slug, { label: t.label, colour: t.colour }]),
  ),
  cardTitles: Object.fromEntries(
    interview.cards.map((c) => [c.cardId, cards.get(c.cardId)?.title ?? c.cardId]),
  ),
  // the references this film raises, with everywhere else they are raised
  cardData: Object.fromEntries(
    [...new Set(interview.cards.map((c) => c.cardId))]
      .map((id) => cards.get(id))
      .filter((c): c is NonNullable<typeof c> => !!c)
      .map((c) => [
        c.title,
        {
          slug: c.slug,
          body: safeBody(c.body),
          subtitle: c.subtitle ?? null,
          image: c.image ? `${base}${c.image}` : null,
          external: c.external ?? null,
          location: c.location ?? null,
          also: appearances(c.slug).map((a) => ({
            slug: a.slug,
            name: a.name,
            time: a.time,
            topicId: a.topicId,
            topicLabel: a.topicId ? (topics.get(a.topicId)?.label ?? a.topicId) : null,
          })),
        },
      ]),
  ),
  basis,
  base,
  here: interview.slug,
  speakerName: interview.interviewee.name,
  topicList: allTopicsWithFilm.map((t) => ({ ...t, mine: mine.has(t.slug) })),
  people: everyone,
};
---

<main class="void">
  <div class="stage">
    <h1 class="title title--left title--idle"></h1>
    <p class="title title--right title--following">
      <button class="peopledoor" aria-expanded="false" aria-controls="topicfield"
              title="every speaker in the archive">{interview.interviewee.name}</button>
    </p>

    <figure class:list={["projection", { "projection--dead": !source }]}>
      <canvas class="projection__bloom" aria-hidden="true"></canvas>
      <div class="projection__frame">
        {
          source ? (
            <>
              <video class="projection__video" playsinline preload="metadata" aria-label={`Interview with ${interview.interviewee.name}`} />
              <div class="projection__feather" aria-hidden="true" />
              <div class="titlebar">
                <h2 class="titlebar__name">{interview.interviewee.name}</h2>
                <p class="titlebar__job">{interview.interviewee.jobtitle}</p>
                <p class="titlebar__on">
                  <span class="titlebar__prep">on</span>
                  <span class="titlebar__topic"></span>
                </p>
              </div>
              <p class="modesay" hidden aria-live="polite"></p>
              <div class="projection__sound">Sound is off — click the film to turn it on</div>
            </>
          ) : (
            <p class="dead-note">
              The film is not reachable right now. The interview’s themes and
              references below remain the record.
            </p>
          )
        }
        <div class="projection__dim" aria-hidden="true"></div>
      </div>
    </figure>

  <div class="scrub" role="slider" aria-label="Timeline" tabindex="0">
      <div class="scrub__track">
        {
          spans.map((s) =>
            s.colour ? (
              <span class="scrub__segment" style={`width:${s.width}%;background:${s.colour}`} title={s.label} />
            ) : (
              <span class="scrub__segment" style={`width:${s.width}%;background:transparent`} />
            ),
          )
        }
      </div>
      {interview.cards.map((c) => <span class="scrub__card" style={`left:${(c.time / basis) * 100}%`} />)}
      <div class="scrub__playhead" style="left:0%"></div>
    </div>

    <nav class="modeswitch" aria-label="Follow a theme, or follow a speaker"></nav>

  <div class="nowline">
      <span class="nowline__card"></span>
    </div>

    <nav class="topics" aria-label="Themes in this interview — each jumps to where it is spoken">
    <span class="topics__lead">Themes in this interview:</span>
      {
        interviewTopics.map((t) => (
          <button
            class="topic"
            type="button"
            data-topic={t.slug}
            style={`--topic-colour:${t.colour}`}
            title={`jump to where ${interview.interviewee.name} speaks on ${t.label}`}
          >
            {t.label}
          </button>
        ))
      }
    </nav>
  </div>

  <aside class="cardpanel" hidden>
    <button class="cardpanel__close" aria-label="close">×</button>
    <h2 class="cardpanel__title"></h2>
    <div class="cardpanel__body"></div>
    <div class="cardpanel__also"></div>
    <button class="cardpanel__more" type="button">read the full reference →</button>
  </aside>

  <div class="reference" hidden role="dialog" aria-modal="true" aria-label="Reference">
    <article class="reference__sheet">
      <button class="reference__close" aria-label="close and carry on watching">×</button>
      <figure class="reference__figure" hidden><img class="reference__img" alt="" /></figure>
      <h2 class="reference__title"></h2>
      <p class="reference__sub"></p>
      <div class="reference__body"></div>
      <p class="reference__links" hidden></p>
      <p class="reference__resume">close to carry on watching</p>
    </article>
  </div>

  <nav class="topicfield" id="topicfield" hidden aria-label="Themes and speakers">
    <button class="topicfield__close" aria-label="close">×</button>
    <div class="topicfield__row"></div>
  </nav>

  <script type="application/json" id="cpmb-data" set:html={JSON.stringify(clientData)} />
</main>

<script>
  import "../player/screen.ts";
</script>
