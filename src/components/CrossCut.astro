---
import type { Topic } from "../lib/content";
import { cards, topics as allTopics } from "../lib/content";
import { crossCut, published } from "../lib/crosscut";
import { safeBody, appearances } from "../lib/cards";
import { musicTracks, seedOf } from "../lib/music";

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const { playable, awaiting } = crossCut(topic.slug);
const total = playable.reduce((a, i) => a + (i.end - i.start), 0);
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;

// Every topic that has something to play, for the field behind the title.
// Weight is voices, not segments: a topic four people circle is a bigger
// thing in this archive than one somebody returns to four times.
const field = [...allTopics.values()]
  .map((t) => ({
    slug: t.slug,
    label: t.label,
    voices: new Set(crossCut(t.slug).playable.map((i) => i.slug)).size,
  }))
  .filter((t) => t.voices > 0)
  .sort((a, b) => a.label.localeCompare(b.label));

// What each speaker themselves covers, so the menu can open the way the 2014
// one did: this person's topics first, then everyone else's.
const speakerTopics: Record<string, string[]> = {};
for (const iv of published()) {
  const seen: string[] = [];
  for (const seg of [...iv.segments].sort((a, b) => a.start - b.start))
    if (!seen.includes(seg.topicId) && allTopics.has(seg.topicId)) seen.push(seg.topicId);
  speakerTopics[iv.slug] = seen;
}

// only the cards this cross-cut can actually raise
const usedCards = new Set(playable.flatMap((i) => i.cards.map((c) => c.title)));
const clientData = {
  items: playable,
  topic: { label: topic.label, colour: topic.colour },
  base: import.meta.env.BASE_URL.replace(/\/$/, ""),
  field,
  speakerTopics,
  here: topic.slug,
  // everyone in the archive, so the right-hand title opens as a door too
  people: published()
    .map((iv) => ({ slug: iv.slug, name: iv.interviewee.name, jobtitle: iv.interviewee.jobtitle }))
    .sort((a, b) => a.name.localeCompare(b.name)),
  music: { tracks: musicTracks(), seed: seedOf(topic.slug) },
  // Each reference carries every other moment it is raised, anywhere in the
  // archive. A name mentioned in passing is not just a footnote on this turn;
  // it is a thread, and the other people pulling it should be reachable.
  cards: Object.fromEntries(
    [...cards.values()]
      .filter((c) => usedCards.has(c.title))
      .map((c) => [
        c.title,
        {
          slug: c.slug,
          body: safeBody(c.body),
          subtitle: c.subtitle ?? null,
          image: c.image ? `${import.meta.env.BASE_URL.replace(/\/$/, "")}${c.image}` : null,
          external: c.external ?? null,
          location: c.location ?? null,
          also: appearances(c.slug).map((a) => ({
            slug: a.slug,
            name: a.name,
            time: a.time,
            topicId: a.topicId,
            topicLabel: a.topicId ? (allTopics.get(a.topicId)?.label ?? a.topicId) : null,
          })),
        },
      ]),
  ),
};
---

{
  /* the first playlist is wanted before any script runs */
  playable.length > 0 && (
    <link rel="preload" as="fetch" crossorigin href={playable[0].hls} />
  )
}

<main class="void">
  <div class="stage stage--crosscut">
    <h1 class="title title--left title--following" style={`color:${topic.colour}`}>
      <button class="topicdoor" aria-expanded="false" aria-controls="topicfield"
              title="every theme in the archive">{topic.label}</button>
    </h1>
    <p class="title title--right title--idle">
      <button class="peopledoor" aria-expanded="false" aria-controls="topicfield"
              title="every speaker in the archive">{playable.length ? playable[0].name : ""}</button>
    </p>

    <figure class:list={["projection", { "projection--dead": !playable.length }]}>
      <canvas class="projection__bloom" aria-hidden="true"></canvas>
      <div class="projection__frame">
        {
          playable.length ? (
            <>
              {/* the engine parks the first turn on the SECOND element, so that one fronts */}
              <video class="projection__video" playsinline preload="auto" aria-hidden="true" />
              <video class="projection__video is-front" playsinline preload="auto" aria-label={`Everyone on ${topic.label}`} />
              <div class="projection__feather" aria-hidden="true" />
              <img class="projection__loader" src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/img/loader-ced.gif`}
                   alt="" aria-hidden="true" width="129" height="100" />
              <div class="titlebar">
                <h2 class="titlebar__name"><a class="titlebar__link"
                  href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/interview/${playable.length ? playable[0].slug : ""}/`}
                  title="watch the whole interview">{playable.length ? playable[0].name : ""}</a></h2>
                <p class="titlebar__job">{playable.length ? playable[0].jobtitle : ""}</p>
                <p class="titlebar__on">
                  <span class="titlebar__prep">on</span>
                  <span class="titlebar__topic" style={`color:${topic.colour}`}>{topic.label}</span>
                </p>
              </div>
              <div class="projection__sound">Sound is off — click the film to turn it on</div>
            </>
          ) : (
            <p class="dead-note">
              No film for this topic is reachable yet — the interviews below
              hold it, and their films arrive as they are transcoded.
            </p>
          )
        }
        <div class="projection__dim" aria-hidden="true"></div>
      </div>
    </figure>

    {
      playable.length > 0 && (
        <>
          <div class="scrub" role="slider" aria-label="Cross-cut timeline" tabindex="0">
            <div class="scrub__track">
              {playable.map((i) => (
                <span
                  class="scrub__segment scrub__segment--cut"
                  style={`width:${((i.end - i.start) / total) * 100}%;background:${topic.colour}`}
                  title={`${i.name} — ${fmt(i.end - i.start)}`}
                />
              ))}
            </div>
            <div class="scrub__playhead" style="left:0%" />
          </div>

          <aside class="cardpanel" hidden>
        <button class="cardpanel__close" aria-label="close">×</button>
        <h2 class="cardpanel__title"></h2>
        <div class="cardpanel__body"></div>
        <div class="cardpanel__also"></div>
        <button class="cardpanel__more" type="button">read the full reference →</button>
      </aside>

      <div class="nowline">
            <span class="nowline__topic" style={`color:${topic.colour}`} />
            <span class="nowline__card" />
          </div>
        </>
      )
    }

    <nav class="topics" aria-label="Speakers on this theme — click to hear theirs">
      {playable
        .filter((i, n) => playable.findIndex((x) => x.slug === i.slug) === n)
        .map((i) => (
          <button class="topic" data-speaker={i.slug} style={`--topic-colour:${topic.colour}`}
                  title={`hear ${i.name} on ${topic.label}`}>{i.name}</button>
        ))}
      {awaiting.map((a) => (
        <span class="topic topic--awaiting" title="film not yet online">{a.name}</span>
      ))}
    </nav>
  </div>

  <div class="reference" hidden role="dialog" aria-modal="true" aria-label="Reference">
    <article class="reference__sheet">
      <button class="reference__close" aria-label="close and carry on watching">×</button>
      <figure class="reference__figure" hidden><img class="reference__img" alt="" /></figure>
      <h2 class="reference__title"></h2>
      <p class="reference__sub"></p>
      <div class="reference__body"></div>
      <p class="reference__links" hidden></p>
      <p class="reference__resume">close to carry on watching</p>
    </article>
  </div>

  <nav class="topicfield" id="topicfield" hidden aria-label="Every theme in the archive">
    <button class="topicfield__close" aria-label="close">×</button>
    <div class="topicfield__row"></div>
  </nav>

  <script type="application/json" id="cpmb-crosscut" set:html={JSON.stringify(clientData)} />
</main>

<script>
  import "../player/crosscut.ts";
</script>
