---
import Base from "../../layouts/Base.astro";
import Player from "../../components/Player.astro";
import { interviews } from "../../lib/content";

export function getStaticPaths() {
  return [...interviews.keys()].map((slug) => ({ params: { slug } }));
}

const interview = interviews.get(Astro.params.slug)!;
---

<Base title={`${interview.interviewee.name} — Cedric Price Memory Bank`} current="bank">
  <Player interview={interview} />
</Base>
