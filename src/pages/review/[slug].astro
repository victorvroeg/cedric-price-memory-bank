---
import Base from "../../layouts/Base.astro";
import { interviews, topics, cards } from "../../lib/content";
import { resolveVideoSource } from "../../lib/resolveVideoSource";
import { LANGUAGES } from "../../lib/languages";

// The review tool is published with the site so the maintainer can reach it
// from anywhere. It is deliberately still a static page: it reads the archive
// and hands back a corrected topic map, but writes nothing and stores nothing.
// Approval travels back through GitHub's own editor — see the Approve button.
// No server, no login of ours, nothing to rot between one interview and the next.
export function getStaticPaths() {
  return [...interviews.keys()].map((slug) => ({ params: { slug } }));
}

const interview = interviews.get(Astro.params.slug)!;
const source = resolveVideoSource(interview);

// The transcript is optional: an interview can be reviewed without one.
const transcripts = import.meta.glob("../../../content/transcripts/*.json", { eager: true });
type Tr = { default: { cues: { start: number; end: number; text: string }[]; corrected?: boolean } };
const tr = transcripts[`../../../content/transcripts/${interview.slug}.json`] as Tr | undefined;

// Every translation of it, so they can be corrected against the English and
// against the film, which is the only way a machine translation gets better.
const translations: Record<string, { cues: { text: string }[]; corrected: boolean }> = {};
for (const l of LANGUAGES) {
  if (l.code === "en") continue;
  const t = transcripts[`../../../content/transcripts/${interview.slug}.${l.code}.json`] as Tr | undefined;
  if (t) translations[l.code] = { cues: t.default.cues, corrected: t.default.corrected ?? false };
}

const data = {
  slug: interview.slug,
  jobtitle: interview.interviewee.jobtitle,
  recorded: interview.recorded,
  duration: interview.video.duration ?? 0,
  hls: source?.url ?? null,
  segments: interview.segments,
  cards: interview.cards,
  cues: tr?.default.cues ?? [],
  corrected: tr?.default.corrected ?? false,
  translations,
  languages: LANGUAGES,
  topics: [...topics.values()]
    .map((t) => ({ id: t.slug, label: t.label, colour: t.colour }))
    .sort((a, b) => a.label.localeCompare(b.label)),
  cardTitles: Object.fromEntries([...cards.values()].map((c) => [c.slug, c.title])),
};
---

<Base title={`Review — ${interview.interviewee.name}`}>
  <main class="review">
    <header class="review__head">
      <h1>{interview.interviewee.name}</h1>
      <div class="review__identity">
        <label>credit line
          <input id="jobtitle" value={interview.interviewee.jobtitle} placeholder="e.g. Architect and urbanist" size="30" />
        </label>
        <label>recorded
          <input id="recorded" value={interview.recorded} placeholder="YYYY-MM-DD" size="12" />
        </label>
      </div>
      <p>
        {interview.draft ? "DRAFT — not in the memory bank" : "published"} ·
        {interview.segments.length} segments · {Math.round(interview.video.duration ?? 0)}s
        {data.cues.length ? ` · transcript ${data.corrected ? "corrected" : "uncorrected"}` : " · no transcript"}
      </p>
    </header>

    <div class="review__player">
      <video class="review__video" playsinline controls></video>
      <div class="review__timeline" id="timeline"></div>
      <div class="review__time"><span id="clock">0:00</span> <span id="hint">click a segment to play it · drag its edges to trim · type timecode for frame accuracy</span></div>
    </div>

    <div class="review__cols">
      <section class="review__segments">
        <div class="review__bar">
          <strong>Segments</strong>
          <button id="add">+ add at playhead</button>
        </div>
        <ol id="segments"></ol>
      </section>

      <section class="review__transcript">
        <div class="review__bar">
          <strong>Transcript</strong>
          <span class="dim">click the time to play · click the words to correct them</span>
          <select id="lang" title="which language to correct">
            {LANGUAGES.map((l) => (
              <option value={l.code} disabled={l.code !== "en" && !translations[l.code]}>
                {l.english}{l.code !== "en" && !translations[l.code] ? " — not translated yet" : ""}
              </option>
            ))}
          </select>
        </div>
        <div class="review__find">
          <input id="find" placeholder="find (e.g. Fuxas)" size="14" />
          <input id="repl" placeholder="replace with" size="14" />
          <button id="doreplace">replace all</button>
          <span id="findstatus" class="dim"></span>
        </div>
        <div id="cues"></div>
      </section>
    </div>

    <footer class="review__foot">
      <button id="propose" class="primary">Approve and send to memory bank</button>
      <button id="download">Download file</button>
      <button id="dlcaptions">Download this language</button>
      <button id="export">Copy JSON</button>
      <button id="revert">Discard my changes</button>
      <span id="status" class="dim"></span>
      <span id="saved" class="dim"></span>
    </footer>
  </main>

  <script type="application/json" id="review-data" set:html={JSON.stringify(data)}></script>
</Base>

<script>
  import "../../player/review.ts";
</script>
