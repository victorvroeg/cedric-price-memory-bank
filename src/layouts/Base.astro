---
import "../styles/global.css";
import { colofon } from "../lib/content";
import { safeBody } from "../lib/cards";

interface Props {
  title: string;
  current?: string;
}
const { title, current } = Astro.props;
const href = (p: string) => (import.meta.env.BASE_URL + "/" + p).replace(/\/+/g, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="The Cedric Price Memory Bank — interviews with the network of Cedric Price, cut sideways by topic." />
    <!-- CP / MB, recovered from the 2014 site: same mark, same archive -->
    <link rel="icon" type="image/png" sizes="32x32" href={href("/favicon-32x32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={href("/favicon-16x16.png")} />
    <link rel="icon" type="image/png" sizes="96x96" href={href("/favicon-96x96.png")} />
    <link rel="icon" type="image/png" sizes="192x192" href={href("/favicon-192x192.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={href("/apple-touch-icon-180x180.png")} />
    <link rel="apple-touch-icon" sizes="152x152" href={href("/apple-touch-icon-152x152.png")} />
    <link rel="apple-touch-icon" sizes="120x120" href={href("/apple-touch-icon-120x120.png")} />
    <link rel="apple-touch-icon" sizes="76x76" href={href("/apple-touch-icon-76x76.png")} />
    <link rel="shortcut icon" href={href("/favicon.ico")} />
    <meta name="theme-color" content="#000000" />

    <!-- open the connection to the video host while the page is still parsing -->
    <link rel="preconnect" href="https://customer-syg1o9n270h63juf.cloudflarestream.com" crossorigin />
    <link rel="dns-prefetch" href="https://customer-syg1o9n270h63juf.cloudflarestream.com" />
  </head>
  <body>
    <nav class="menu" aria-label="Site">
      <button class="menu__mark" aria-expanded="false" aria-controls="colofon">Memory Bank</button>
    </nav>

    <div class="colofon" id="colofon" hidden role="dialog" aria-modal="true" aria-label="Colofon">
      <article class="colofon__sheet">
        <button class="colofon__close" aria-label="close">×</button>
        <h2 class="colofon__title">{colofon.title}</h2>
        <div class="colofon__body" set:html={safeBody(colofon.body)} />
        <p class="colofon__home"><a href={href("/")}>back to the beginning</a></p>
      </article>
    </div>

    <slot />

    <script>
      // The colofon is a thing you look at, not a place you go. Nothing that
      // is playing stops for it.
      const mark = document.querySelector<HTMLButtonElement>(".menu__mark");
      const sheet = document.querySelector<HTMLElement>(".colofon");
      const shut = () => {
        if (!sheet || sheet.hidden) return;
        sheet.hidden = true;
        mark?.setAttribute("aria-expanded", "false");
      };
      mark?.addEventListener("click", () => {
        if (!sheet) return;
        const open = sheet.hidden;
        sheet.hidden = !open;
        mark.setAttribute("aria-expanded", String(open));
      });
      sheet?.querySelector(".colofon__close")?.addEventListener("click", shut);
      sheet?.addEventListener("click", (e) => {
        if (!(e.target as Element).closest(".colofon__sheet")) shut();
      });
      addEventListener("keydown", (e) => { if (e.key === "Escape") shut(); });
    </script>
  </body>
</html>
