{
 "slug": "brett-steele.ja",
 "language": "ja",
 "model": "claude-fable-5",
 "source": "en",
 "corrected": false,
 "cues": [
  {
   "start": 0.0,
   "end": 15.0,
   "text": "Cedric Price について一番面白い問いは 彼が今も どうして Cedric が今も建築文化の一部でありうるのか ということだと思う そういう問いが立てられる"
  },
  {
   "start": 15.0,
   "end": 24.24,
   "text": "私の見方では Cedric は現代の建築に取り憑いている存在だ"
  },
  {
   "start": 24.24,
   "end": 31.02,
   "text": "Cedric が思い描いた21世紀の建築は 根本的に違うものだった"
  },
  {
   "start": 31.02,
   "end": 37.48,
   "text": "今の姿とは 彼の経歴も信念も直感も 建築を"
  },
  {
   "start": 37.48,
   "end": 44.58,
   "text": "アイデアの文化として 時には世界がどうありうるかの思考実験として捉えていた"
  },
  {
   "start": 44.58,
   "end": 52.84,
   "text": "そして建築の仕事の一部は 私たちの知る世界に問いを投げることだと"
  },
  {
   "start": 53.14,
   "end": 58.26,
   "text": "その意味で彼は建築と その現在に取り憑いている"
  },
  {
   "start": 58.26,
   "end": 63.24,
   "text": "建築のとめどない専門職化と"
  },
  {
   "start": 63.6,
   "end": 69.92,
   "text": "商業的現実 そして私が時に産業的状況と呼ぶもののせいで"
  },
  {
   "start": 69.92,
   "end": 74.92,
   "text": "建築は時に恐ろしいほどのやり方で産業化している"
  },
  {
   "start": 74.92,
   "end": 78.92,
   "text": "より多くこなし より考えないことが上手くなっている"
  },
  {
   "start": 78.92,
   "end": 83.92,
   "text": "つまり建築は 誰もが想像した以上に Cedric から遠ざかっている"
  },
  {
   "start": 83.92,
   "end": 88.92,
   "text": "今も消えない第一印象は 彼がイギリス人だということ"
  },
  {
   "start": 88.92,
   "end": 94.92,
   "text": "そこには二つの際立った性質があった 私のような粗野なアメリカ人には"
  },
  {
   "start": 94.92,
   "end": 102.36,
   "text": "一つは Cedric の即座の機知と遊び心 これは人が"
  },
  {
   "start": 102.36,
   "end": 111.86,
   "text": "彼の人柄の第一の特質として強調しすぎだと思う 実際とても機知に富む人だった"
  },
  {
   "start": 111.86,
   "end": 119.24,
   "text": "表面上は冗談好きで遊び好きに見えたが 彼がしていたのは"
  },
  {
   "start": 119.24,
   "end": 124.74,
   "text": "その冗談や 実験やゲームを通して"
  },
  {
   "start": 124.74,
   "end": 129.64,
   "text": "建築家の習慣と前提を問い直すことだった 本当は死ぬほど"
  },
  {
   "start": 129.64,
   "end": 135.92,
   "text": "真剣な仕事を 最もイギリス的で控えめな作法で見せていた 驚くほど"
  },
  {
   "start": 135.92,
   "end": 143.06,
   "text": "見事な批評の方法だ 遊び心が一番際立つ性質だっただろう"
  },
  {
   "start": 143.06,
   "end": 149.72,
   "text": "だが彼の仕事の全体を知るにつれ 今日まで考え続けて"
  },
  {
   "start": 149.72,
   "end": 157.84,
   "text": "いることがある その裏側にあるイギリス性は 実は深くロンドン的な感性で"
  },
  {
   "start": 157.84,
   "end": 164.98,
   "text": "建築を世界的な文化の中で見て 近代建築が"
  },
  {
   "start": 164.98,
   "end": 173.34,
   "text": "その時々どこにいるかを正確に知る力だ その力の出所は分からないが"
  },
  {
   "start": 173.34,
   "end": 180.34,
   "text": "その多くは 彼が建築の動きと常に深くつながる場所に"
  },
  {
   "start": 180.8,
   "end": 185.52,
   "text": "身を置いていたからだ 忘れてはいけない ロンドンは実に特異な"
  },
  {
   "start": 185.52,
   "end": 192.52,
   "text": "建築文化だ 何十年も前から世界に開かれている 私が心底好きな"
  },
  {
   "start": 192.66,
   "end": 198.8,
   "text": "AA での出来事の写真がある 世界中の講演でずっと使ってきた"
  },
  {
   "start": 198.8,
   "end": 206.8,
   "text": "1950年代末 今の講堂にあたる場所で撮られた写真だ"
  },
  {
   "start": 206.8,
   "end": 212.8,
   "text": "当時は協会の会員スペースだったところ"
  },
  {
   "start": 212.8,
   "end": 217.8,
   "text": "広場に面した長い壁の中央にいるのは 年老いた"
  },
  {
   "start": 217.8,
   "end": 222.8,
   "text": "そして私には不機嫌そうに見える Walter Gropius で 講演している"
  },
  {
   "start": 222.8,
   "end": 227.8,
   "text": "晩餐のテーブルに並ぶ紳士淑女に向かって"
  },
  {
   "start": 227.8,
   "end": 231.92,
   "text": "とても美しい写真で Gropius はノートと老眼鏡を手に"
  },
  {
   "start": 231.92,
   "end": 235.1,
   "text": "近代建築とは何かを高らかに宣言している"
  },
  {
   "start": 235.2,
   "end": 240.3,
   "text": "その手前で 斜めを向いて床を見下ろして座っているのが"
  },
  {
   "start": 240.38,
   "end": 245.18,
   "text": "若き Cedric Price 室内で唯一 Gropius を見ていない人物だ"
  },
  {
   "start": 245.78,
   "end": 251.88,
   "text": "Cedric は宙を見つめ Gropius の話を明らかに咀嚼しているが"
  },
  {
   "start": 251.88,
   "end": 254.38,
   "text": "決して巨匠に付き従ってはいない"
  },
  {
   "start": 254.38,
   "end": 259.48,
   "text": "部屋の他の全員が明らかにそうしているようには"
  },
  {
   "start": 259.9,
   "end": 263.62,
   "text": "Cedric はもう 卒業からわずか数年で"
  },
  {
   "start": 264.04,
   "end": 266.18,
   "text": "違う方向へ建築を考えている"
  },
  {
   "start": 266.34,
   "end": 268.96,
   "text": "その能力の見事な記録だと思う"
  },
  {
   "start": 268.96,
   "end": 271.3,
   "text": "彼の経歴のごく初めからの"
  },
  {
   "start": 271.88,
   "end": 275.54,
   "text": "それを可能にした一番の要因は"
  },
  {
   "start": 275.54,
   "end": 277.48,
   "text": "個人の知性だけではなく"
  },
  {
   "start": 277.48,
   "end": 285.48,
   "text": "1950年代のここで 近代建築文化の多様な思想に触れていたことだ"
  },
  {
   "start": 286.36,
   "end": 292.76,
   "text": "当時すでに他にない形で国際化しつつあった都市で"
  },
  {
   "start": 293.16,
   "end": 299.14,
   "text": "建てること以外の活動で影響力を持つ経歴は 前例がないわけではない"
  },
  {
   "start": 300.42,
   "end": 302.44,
   "text": "Cedric はその極端な例だ"
  },
  {
   "start": 302.44,
   "end": 306.94,
   "text": "多くの人がすぐ挙げる答えは"
  },
  {
   "start": 306.94,
   "end": 309.92,
   "text": "その思想が重要だったから"
  },
  {
   "start": 309.92,
   "end": 312.94,
   "text": "他の頭脳が周りに集まり 仕事が生まれ"
  },
  {
   "start": 312.94,
   "end": 316.3,
   "text": "影響力が及ぶのが見えた というものだろう"
  },
  {
   "start": 316.3,
   "end": 319.14,
   "text": "よく語られてきた系譜だ"
  },
  {
   "start": 319.14,
   "end": 320.56,
   "text": "ここで繰り返す必要はない"
  },
  {
   "start": 320.56,
   "end": 325.14,
   "text": "Cedric の思想がハイテク建築の基礎になり"
  },
  {
   "start": 325.14,
   "end": 328.6,
   "text": "それが商業化され 建てられていく"
  },
  {
   "start": 328.6,
   "end": 329.62,
   "text": "彼の後に続く世代によって"
  },
  {
   "start": 329.62,
   "end": 334.9,
   "text": "だが彼の経歴に影響力をたどれるもう一つの理由は"
  },
  {
   "start": 335.04,
   "end": 338.14,
   "text": "私はこちらを強く支持し信じているが"
  },
  {
   "start": 338.26,
   "end": 343.26,
   "text": "影響力と呼ぶものがその形で成り立ちえたのは"
  },
  {
   "start": 343.26,
   "end": 345.9,
   "text": "とりわけ20世紀のあの時期だったからだ"
  },
  {
   "start": 346.6,
   "end": 349.54,
   "text": "つまり建設量が多くなかった時期"
  },
  {
   "start": 349.78,
   "end": 353.42,
   "text": "戦後イギリスの建設ラッシュが落ち着き始めた頃"
  },
  {
   "start": 354.2,
   "end": 358.02,
   "text": "実際 1960年代から70年代の建築文化は"
  },
  {
   "start": 358.02,
   "end": 361.46,
   "text": "建てない世界だった"
  },
  {
   "start": 362.58,
   "end": 365.04,
   "text": "それも徹底的に と言っていいほど"
  },
  {
   "start": 365.2,
   "end": 367.7,
   "text": "1950年代の大ブームのあと"
  },
  {
   "start": 367.84,
   "end": 371.58,
   "text": "戦後のイギリスやヨーロッパの多くが"
  },
  {
   "start": 371.58,
   "end": 373.82,
   "text": "破壊から自らを建て直さねばならなかった"
  },
  {
   "start": 374.38,
   "end": 377.76,
   "text": "その動きは50年代末には落ち着き始める"
  },
  {
   "start": 377.76,
   "end": 380.78,
   "text": "ちょうど Cedric の経歴が現れ始める瞬間に"
  },
  {
   "start": 382.72,
   "end": 386.58,
   "text": "そして建築は"
  },
  {
   "start": 386.58,
   "end": 389.5,
   "text": "AA がその見事な記録だが"
  },
  {
   "start": 389.76,
   "end": 394.24,
   "text": "建築は思想と原理の議論になり"
  },
  {
   "start": 394.24,
   "end": 398.84,
   "text": "ありうる計画の議論になる もちろん後に実現するが"
  },
  {
   "start": 398.84,
   "end": 402.9,
   "text": "経済などの活動が加速してからのことだ"
  },
  {
   "start": 403.42,
   "end": 410.14,
   "text": "だから その可能性を抽出する Cedric の力は"
  },
  {
   "start": 410.14,
   "end": 413.36,
   "text": "それが支配的な方法になる まさにその瞬間に働いた"
  },
  {
   "start": 413.36,
   "end": 416.2,
   "text": "あなたや私が影響力と呼ぶものを伝える方法として"
  },
  {
   "start": 416.2,
   "end": 420.26,
   "text": "今はまったく逆の状況だ 基本的に誰もが建てている"
  },
  {
   "start": 421.14,
   "end": 427.0,
   "text": "原理や思想によって影響力が及ぶ姿は ほとんど想像もできない"
  },
  {
   "start": 427.18,
   "end": 429.46,
   "text": "だからこそ今また実に面白い課題になる"
  },
  {
   "start": 429.56,
   "end": 434.36,
   "text": "2014年に私たちが Cedric を語る意味もそこにある"
  },
  {
   "start": 435.38,
   "end": 439.66,
   "text": "面白い問いがある Cedric の最も重要なプロジェクトは何か"
  },
  {
   "start": 439.66,
   "end": 444.12,
   "text": "私の答えは彼の事務所だ"
  },
  {
   "start": 444.72,
   "end": 446.22,
   "text": "事務所をつくったこと"
  },
  {
   "start": 446.22,
   "end": 448.62,
   "text": "個々の設計ではない"
  },
  {
   "start": 448.62,
   "end": 451.76,
   "text": "160の設計案のどれでもない"
  },
  {
   "start": 453.18,
   "end": 455.02,
   "text": "記憶が正しければ"
  },
  {
   "start": 455.02,
   "end": 457.32,
   "text": "150か160のプロジェクトを"
  },
  {
   "start": 457.32,
   "end": 459.8,
   "text": "40年か50年の仕事の中で手がけている"
  },
  {
   "start": 461.18,
   "end": 462.64,
   "text": "今や世界中の誰もが"
  },
  {
   "start": 462.64,
   "end": 464.72,
   "text": "Fun Palace を死ぬほど愛していて"
  },
  {
   "start": 464.72,
   "end": 466.34,
   "text": "他より重要なプロジェクトがあると"
  },
  {
   "start": 466.34,
   "end": 467.54,
   "text": "言いたがる"
  },
  {
   "start": 467.54,
   "end": 472.84,
   "text": "こうも全員が一致して"
  },
  {
   "start": 472.84,
   "end": 476.84,
   "text": "Cedric の Fun Palace が20世紀で最も重要な建築だと"
  },
  {
   "start": 476.84,
   "end": 480.44,
   "text": "認める時代が心配だ 突然全員が同意できるのは奇妙に思える"
  },
  {
   "start": 480.9,
   "end": 484.88,
   "text": "AA の講評会に一週間通っても 誰もが"
  },
  {
   "start": 484.88,
   "end": 488.84,
   "text": "Fun Palace を延々と称えるだけだ 彼はそれを恐れただろう"
  },
  {
   "start": 490.12,
   "end": 492.02,
   "text": "世代的な症状として"
  },
  {
   "start": 493.1,
   "end": 496.78,
   "text": "この問いに少し違う見方を示すなら"
  },
  {
   "start": 496.78,
   "end": 499.72,
   "text": "私も皆と同じ理由で Fun Palace を愛しているが"
  },
  {
   "start": 500.04,
   "end": 505.16,
   "text": "実際には彼の事務所の設計のしかたこそ"
  },
  {
   "start": 505.16,
   "end": 506.72,
   "text": "非常に重要になると思う"
  },
  {
   "start": 506.72,
   "end": 510.7,
   "text": "彼は事務所を思想の保管庫とするモデルをつくったからだ"
  },
  {
   "start": 510.7,
   "end": 514.48,
   "text": "建物を生産する工場としてではなく"
  },
  {
   "start": 515.92,
   "end": 520.04,
   "text": "これが分かるのは Samantha Hardingham と"
  },
  {
   "start": 520.04,
   "end": 522.0,
   "text": "他の同僚たちの仕事のおかげだ"
  },
  {
   "start": 522.0,
   "end": 526.3,
   "text": "彼の事務所のアーカイブ整理をめぐる仕事"
  },
  {
   "start": 526.3,
   "end": 529.64,
   "text": "彼はそれも数ある設計プロジェクトの一つと見ていた"
  },
  {
   "start": 530.3,
   "end": 532.32,
   "text": "そして振り返って気づくのは"
  },
  {
   "start": 532.32,
   "end": 535.74,
   "text": "Cedric が最初から知の組織化を理解していたことだ"
  },
  {
   "start": 535.82,
   "end": 537.66,
   "text": "建築家としての自分の経験さえも"
  },
  {
   "start": 538.24,
   "end": 542.9,
   "text": "建築家の仕事の中で意識し 明確に扱うべきものだと"
  },
  {
   "start": 543.52,
   "end": 546.8,
   "text": "そこまで自覚的な建築家はごくわずかだ"
  },
  {
   "start": 547.62,
   "end": 551.04,
   "text": "多くは事務所を真剣な仕事をする場としか見ない"
  },
  {
   "start": 551.08,
   "end": 554.22,
   "text": "そして真剣な仕事とは常にあの建物や提案のことだ"
  },
  {
   "start": 554.22,
   "end": 558.16,
   "text": "だが Cedric は 理由はどうあれ"
  },
  {
   "start": 558.26,
   "end": 560.72,
   "text": "ある水準の自己意識と自覚を持っていて"
  },
  {
   "start": 560.72,
   "end": 562.44,
   "text": "そのおかげで見えていた"
  },
  {
   "start": 562.44,
   "end": 566.66,
   "text": "あらゆる建築空間の中でも特別な空間"
  },
  {
   "start": 566.78,
   "end": 568.1,
   "text": "つまり設計スタジオをつくることを"
  },
  {
   "start": 568.68,
   "end": 571.54,
   "text": "自分の経歴の考え方に組み込むべきだと"
  },
  {
   "start": 571.78,
   "end": 574.64,
   "text": "彼はそれをほとんど強迫的なまでに行った"
  },
  {
   "start": 574.64,
   "end": 579.52,
   "text": "図面を分類し 整理し 並べ替える"
  },
  {
   "start": 579.82,
   "end": 583.22,
   "text": "メモ スケッチ 絵葉書 新聞の"
  },
  {
   "start": 583.22,
   "end": 588.52,
   "text": "切り抜きを 今で言えばキュレーター的な"
  },
  {
   "start": 588.52,
   "end": 595.26,
   "text": "執着と呼べるものにまで それは彼の経歴で最も語られない特質だと思う"
  },
  {
   "start": 595.26,
   "end": 599.22,
   "text": "今日のアーカイブの役割をめぐる私たちの会話を思えば 実に"
  },
  {
   "start": 599.22,
   "end": 603.68,
   "text": "面白いモデルだ 建築家が未来に向けて考えるうえで"
  },
  {
   "start": 603.68,
   "end": 609.32,
   "text": "面白い問いがある よく引用される彼の考え"
  },
  {
   "start": 609.32,
   "end": 615.92,
   "text": "建築家は建てる者ではなく可能にする者 その考えにどう至ったか 彼が指すのは"
  },
  {
   "start": 615.92,
   "end": 620.96,
   "text": "20世紀半ばの職能の現実だ 建築家は主に"
  },
  {
   "start": 620.96,
   "end": 626.94,
   "text": "情報と思想の流れの調整役 管理者になる 例えば建物を建てる場面でも"
  },
  {
   "start": 627.04,
   "end": 633.28,
   "text": "他の多くの活動でも 同じ年代に他の人も言っている"
  },
  {
   "start": 633.28,
   "end": 637.18,
   "text": "Cedric が AA にいた頃のことだ"
  },
  {
   "start": 637.18,
   "end": 640.36,
   "text": "建築家は職能としてきわめて特異な位置にある"
  },
  {
   "start": 640.36,
   "end": 644.34,
   "text": "あらゆる専門知の中心に座り"
  },
  {
   "start": 644.34,
   "end": 648.46,
   "text": "その情報の流れを管理しなければならない存在だと"
  },
  {
   "start": 649.46,
   "end": 652.48,
   "text": "だがもう一つ 彼がしているのは もっと"
  },
  {
   "start": 652.48,
   "end": 658.38,
   "text": "思想的な主張だ 建築は建物と同じではない"
  },
  {
   "start": 658.88,
   "end": 661.8,
   "text": "この二つはまったく別の世界だ"
  },
  {
   "start": 661.8,
   "end": 665.8,
   "text": "建物は重要だし 建築文化の中で役割も果たす"
  },
  {
   "start": 665.8,
   "end": 669.8,
   "text": "だが建築文化は本当は思想の世界だ"
  },
  {
   "start": 669.8,
   "end": 675.8,
   "text": "思想は多様な形で表現され 発見され 展開されうる"
  },
  {
   "start": 675.8,
   "end": 677.8,
   "text": "実際に建てることだけではない"
  },
  {
   "start": 677.8,
   "end": 680.8,
   "text": "図面を描くこと 空間をどう移動するかを表すこと"
  },
  {
   "start": 680.8,
   "end": 682.8,
   "text": "そうした活動のすべてで"
  },
  {
   "start": 682.8,
   "end": 688.8,
   "text": "Rem はかつて Price の意図は建築を日常と区別できないものにすることだと言った"
  },
  {
   "start": 688.8,
   "end": 694.08,
   "text": "つまり建築は都市の日常の生活や空間から切り離されていないと"
  },
  {
   "start": 694.24,
   "end": 698.2,
   "text": "それは Cedric の野心というより Rem の投影だと思う"
  },
  {
   "start": 699.2,
   "end": 702.82,
   "text": "Cedric 自身はそう生きたいと強く思っていたのだろう"
  },
  {
   "start": 702.82,
   "end": 707.68,
   "text": "自分が生きた素晴らしい世界と区別のつかない存在でいたかった"
  },
  {
   "start": 707.68,
   "end": 710.54,
   "text": "その一部であり 建築文化よりはるかに大きい世界だ"
  },
  {
   "start": 711.18,
   "end": 715.86,
   "text": "だがそれは 建築がそうなるべきだと論じるのとはまったく違う"
  },
  {
   "start": 715.86,
   "end": 719.96,
   "text": "むしろ Cedric の最も面白い性質の一つは"
  },
  {
   "start": 719.96,
   "end": 723.34,
   "text": "ある本能を避けたことだ"
  },
  {
   "start": 723.34,
   "end": 725.82,
   "text": "Koolhaas をはじめ多くが今体現している本能"
  },
  {
   "start": 725.92,
   "end": 730.28,
   "text": "つまり建築を大規模な原理の集合として見て"
  },
  {
   "start": 730.28,
   "end": 732.62,
   "text": "きわめて広い聴衆に当てはめる本能だ"
  },
  {
   "start": 732.62,
   "end": 734.32,
   "text": "個人の経歴にだけではなく"
  },
  {
   "start": 734.9,
   "end": 737.58,
   "text": "Cedric の経歴の見事さの一部は"
  },
  {
   "start": 737.58,
   "end": 741.4,
   "text": "常にきわめて親密で個人的なものとして考えられていたことだ"
  },
  {
   "start": 741.96,
   "end": 744.4,
   "text": "実際 ほとんど難しいほどに"
  },
  {
   "start": 744.4,
   "end": 747.64,
   "text": "彼のしたことを私たちが自分の生活に当てはめることは"
  },
  {
   "start": 748.6,
   "end": 752.2,
   "text": "これは言ってみれば古典的な"
  },
  {
   "start": 752.2,
   "end": 756.24,
   "text": "モダニズム的な Koolhaas の立場とはまったく違う つまり自分のすることが"
  },
  {
   "start": 756.24,
   "end": 760.3,
   "text": "建築のあるべき姿のモデルになるという立場だ 実に面白く"
  },
  {
   "start": 760.3,
   "end": 764.5,
   "text": "複雑な議論だ おそらくそれが Cedric の唯一の教えで"
  },
  {
   "start": 764.5,
   "end": 767.5,
   "text": "彼の主張を深く信じる"
  },
  {
   "start": 767.5,
   "end": 771.76,
   "text": "追随者たちにあまり受け止められていない"
  },
  {
   "start": 771.76,
   "end": 778.36,
   "text": "多くの人が問う 今の時代の建築にとって Cedric はどんな意味を持ちうるのか"
  },
  {
   "start": 779.02,
   "end": 785.46,
   "text": "私は距離を置いて学べと言いたい 体現しようとせず 延長しようともせず"
  },
  {
   "start": 786.66,
   "end": 797.32,
   "text": "私にとって今 最も落ち着かない問いは その経歴がなぜ今のような形で生きているのか"
  },
  {
   "start": 797.32,
   "end": 805.7,
   "text": "つまりほぼ忘れられ Montreal の CCA の冷たい地下に文字通り埋まっている"
  },
  {
   "start": 806.2,
   "end": 809.1,
   "text": "時に衝撃を覚える"
  },
  {
   "start": 810.1,
   "end": 817.26,
   "text": "これほど重要な仕事が 今の建築からすでに遠く離れている"
  },
  {
   "start": 817.26,
   "end": 822.8,
   "text": "だから多くの人と同じく こうした映画をつくるあなた方もそうだが"
  },
  {
   "start": 822.8,
   "end": 826.2,
   "text": "その思想をどう呼び戻すかという思索は"
  },
  {
   "start": 826.2,
   "end": 828.96,
   "text": "実にきわめて重要な仕事だ"
  },
  {
   "start": 829.46,
   "end": 831.56,
   "text": "今その方法の答えは持っていない"
  },
  {
   "start": 831.68,
   "end": 835.24,
   "text": "個人的な水準では 例えば出版者として"
  },
  {
   "start": 836.14,
   "end": 842.2,
   "text": "あなた方のような人を手伝えたことがこの上なく嬉しい"
  },
  {
   "start": 842.2,
   "end": 845.08,
   "text": "この企画だけでなく 数年前にあなた方がやった見事な仕事"
  },
  {
   "start": 845.08,
   "end": 848.86,
   "text": "Cedric の文章を集めたあの仕事も"
  },
  {
   "start": 848.86,
   "end": 855.66,
   "text": "Samantha による二巻の決定版モノグラフ"
  },
  {
   "start": 855.66,
   "end": 859.98,
   "text": "隠れた経歴を扱い 今年末に出るあの本は"
  },
  {
   "start": 859.98,
   "end": 863.26,
   "text": "50年にわたる建築的発見を記録し"
  },
  {
   "start": 863.26,
   "end": 865.98,
   "text": "私たちの時代の一冊になるだろう"
  },
  {
   "start": 866.4,
   "end": 869.18,
   "text": "私たちの時代にこれ以上重要な本は出ないはずだ"
  },
  {
   "start": 871.24,
   "end": 874.5,
   "text": "ある経歴の広がりを明らかにするからだけではない"
  },
  {
   "start": 874.5,
   "end": 876.28,
   "text": "実際にはごく少数しか知らない経歴で"
  },
  {
   "start": 876.28,
   "end": 877.8,
   "text": "一つ二つの図像を通してしか知られていない"
  },
  {
   "start": 877.8,
   "end": 883.3,
   "text": "その真の幅も見えてくる 講演 パフォーマンス インスタレーション"
  },
  {
   "start": 883.62,
   "end": 886.36,
   "text": "建物の設計 事務所づくり"
  },
  {
   "start": 886.54,
   "end": 890.36,
   "text": "教育者としての歩み 批評家としての活動まで"
  },
  {
   "start": 891.04,
   "end": 892.28,
   "text": "そのすべてが重要になる"
  },
  {
   "start": 893.34,
   "end": 895.88,
   "text": "だがそれは始まりにすぎないと思う"
  },
  {
   "start": 895.88,
   "end": 898.02,
   "text": "より大きな問いを本当に引き出すための"
  },
  {
   "start": 898.02,
   "end": 900.54,
   "text": "つまり そうした経歴をどうすれば"
  },
  {
   "start": 900.54,
   "end": 904.76,
   "text": "今現れつつある世代の建築家にとって再び生きたものにし"
  },
  {
   "start": 904.76,
   "end": 908.48,
   "text": "作り変えや再発見に開かれたものにできるか"
  },
  {
   "start": 908.48,
   "end": 910.52,
   "text": "流用し 使えるようにできるか"
  },
  {
   "start": 910.64,
   "end": 914.38,
   "text": "Cedric ならいつも 後から来る者による誤用と言うだろう"
  },
  {
   "start": 914.62,
   "end": 918.18,
   "text": "彼が私たちに一番望まないのは 崇拝されることだ"
  },
  {
   "start": 919.02,
   "end": 920.84,
   "text": "実際 彼はわざわざ手を尽くして"
  },
  {
   "start": 920.9,
   "end": 922.4,
   "text": "そうならないようにしたと思う"
  },
  {
   "start": 922.62,
   "end": 926.78,
   "text": "忘れてはならない 彼がそうしていたのは"
  },
  {
   "start": 926.78,
   "end": 929.24,
   "text": "建築家がカルト的存在として"
  },
  {
   "start": 930.28,
   "end": 933.32,
   "text": "デザイナー 有名人 独自のOSとして"
  },
  {
   "start": 933.32,
   "end": 935.88,
   "text": "20世紀後半に立ち現れつつあった時代だ"
  },
  {
   "start": 936.36,
   "end": 938.26,
   "text": "彼はできる限りのことをして"
  },
  {
   "start": 938.26,
   "end": 941.0,
   "text": "自分がそういう存在にならないようにした"
  },
  {
   "start": 942.4,
   "end": 944.24,
   "text": "これもおそらくただの本能と"
  },
  {
   "start": 944.24,
   "end": 947.12,
   "text": "とても良い 軽やかで魔法のような触れ方だ"
  },
  {
   "start": 947.12,
   "end": 949.46,
   "text": "世界でどう正しく生きるかについての"
  },
  {
   "start": 950.36,
   "end": 952.98,
   "text": "だが彼は恐ろしさを見ていたと思う"
  },
  {
   "start": 952.98,
   "end": 954.6,
   "text": "建築が何になりつつあるかの"
  },
  {
   "start": 954.82,
   "end": 956.72,
   "text": "どれほど見事な提案があったとしても"
  },
  {
   "start": 956.72,
   "end": 958.12,
   "text": "20世紀初頭には"
  },
  {
   "start": 959.3,
   "end": 961.16,
   "text": "20世紀の終わりの数十年で"
  },
  {
   "start": 961.28,
   "end": 963.08,
   "text": "彼は職能の活動も"
  },
  {
   "start": 963.32,
   "end": 967.02,
   "text": "建築教育も 建築ジャーナリズムも"
  },
  {
   "start": 967.02,
   "end": 970.1,
   "text": "そのすべてが文字通り産業化し"
  },
  {
   "start": 970.1,
   "end": 972.66,
   "text": "大きな 大規模な商業活動になるのを見た"
  },
  {
   "start": 972.66,
   "end": 975.98,
   "text": "世界が思索し考えるための思想を"
  },
  {
   "start": 975.98,
   "end": 978.4,
   "text": "もはや差し出してはおらず"
  },
  {
   "start": 978.4,
   "end": 980.26,
   "text": "ただ自分たちを生かし続けるだけの"
  },
  {
   "start": 980.26,
   "end": 981.74,
   "text": "小さな自己維持装置になっていた"
  },
  {
   "start": 981.74,
   "end": 984.48,
   "text": "彼が本当に私たち皆に求めているのは"
  },
  {
   "start": 984.48,
   "end": 988.28,
   "text": "時々その活動から一歩下がり"
  },
  {
   "start": 988.28,
   "end": 990.32,
   "text": "もう一度考え直すことだと思う"
  },
  {
   "start": 990.32,
   "end": 993.24,
   "text": "最も個人的な水準でさえ"
  },
  {
   "start": 993.24,
   "end": 998.96,
   "text": "その現実に代わる道を示し 思い描けるはずだと"
  },
  {
   "start": 999.74,
   "end": 1001.7,
   "text": "それこそ今 彼が私たちに望む唯一のことで"
  },
  {
   "start": 1001.7,
   "end": 1005.4,
   "text": "自分たちのためでなくとも Cedric のためにやるべきことだ"
  }
 ]
}
