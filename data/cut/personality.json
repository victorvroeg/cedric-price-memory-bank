time":283.72,"title":"The White Room","id":"the-white-room"},{"time":295.64,"title":"AA","id":"aa"},{"time":317.36,"title":"Clip Kit","id":"clip-kit"}]},{"slug":"samantha-hardingham","name":"Samantha Hardingham","jobtitle":"Architectural writer and editor","recorded":"2014-10-30","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/8f6f7744b941fb8eae6c60abd85ab5da/manifest/video.m3u8","start":131,"end":178,"topicId":"personality","segments":[{"start":131,"end":178,"topicId":"personality"}],"cards":[]},{"slug":"samantha-hardingham","name":"Samantha Hardingham","jobtitle":"Architectural writer and editor","recorded":"2014-10-30","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/8f6f7744b941fb8eae6c60abd85ab5da/manifest/video.m3u8","start":341,"end":463,"topicId":"personality","segments":[{"start":341,"end":463,"topicId":"personality"}],"cards":[]},{"slug":"steve-mullin","name":"Steve Mullin","jobtitle":"Former member of the office, architect","recorded":"2014-11-05","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/367f19c5ba47aa14514921fafa34ba07/manifest/video.m3u8","start":0,"end":30,"topicId":"personality","segments":[{"start":0,"end":30,"topicId":"personality"}],"cards":[{"time":26.88,"title":"Cedric Price Office","id":"cedric-price-office"}]},{"slug":"steve-mullin","name":"Steve Mullin","jobtitle":"Former member of the office, architect","recorded":"2014-11-05","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/367f19c5ba47aa14514921fafa34ba07/manifest/video.m3u8","start":1042,"end":1142,"topicId":"personality","segments":[{"start":1042,"end":1142,"topicId":"personality"}],"cards":[]},{"slug":"thomas-weaver","name":"Thomas Weaver","jobtitle":"Architectural writer and editor","recorded":"2014-11-05","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/939360abb6f6477d596ff7cbf0905708/manifest/video.m3u8","start":778,"end":890,"topicId":"personality","segments":[{"start":778,"end":890,"topicId":"personality"}],"cards":[{"time":786.8,"title":"Cedric Price Works","id":"cedric-price-works"},{"time":838.16,"title":"CCA","id":"cca"}]},{"slug":"will-alsop","name":"Will Alsop","jobtitle":"Former member of the office, architect","recorded":"2014-11-05","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/005dfe1884685dc09eac01133744f2ef/manifest/video.m3u8","start":1060,"end":1097,"topicId":"personality","segments":[{"start":1060,"end":1097,"topicId":"personality"}],"cards":[{"time":1092.64,"title":"Richard Meier","id":"richard-meier"}]}],"cards":{"AA":{"slug":"aa","body":"The Architectural Association School of Architecture in London, commonly referred to as the AA, is the oldest independent school of <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Architecture\">architecture</a> in the UK and one of the most prestigious and competitive in the world. Its wide-ranging programme of exhibitions, lectures, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Academic_conference\">symposia</a> and publications have given it a central position in global discussions and developments within contemporary architectural culture.","subtitle":"Architectural Association School of Architecture","image":"/cedric-price-memory-bank/cards/aa.jpg","external":"http://www.aaschool.ac.uk","location":"https://www.google.com/maps/place/36+Bedford+Square,+AA+School+of+Architecture,+Fitzrovia,+London+WC1B+3ES,+UK/@51.5183066,-0.1307022,17z","also":[{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":702,"topicId":"scene","topicLabel":"Scene"},{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":1172.2,"topicId":"network","topicLabel":"Network"},{"slug":"brett-steele","name":"Brett Steele","time":195.92,"topicId":"personality","topicLabel":"Personality"},{"slug":"brett-steele","name":"Brett Steele","time":388.16,"topicId":"influence","topicLabel":"Influence"},{"slug":"brett-steele","name":"Brett Steele","time":483.92,