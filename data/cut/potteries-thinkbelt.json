tle":"Architectural Association School of Architecture","image":"/cedric-price-memory-bank/cards/aa.jpg","external":"http://www.aaschool.ac.uk","location":"https://www.google.com/maps/place/36+Bedford+Square,+AA+School+of+Architecture,+Fitzrovia,+London+WC1B+3ES,+UK/@51.5183066,-0.1307022,17z","also":[{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":702,"topicId":"scene","topicLabel":"Scene"},{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":1172.2,"topicId":"network","topicLabel":"Network"},{"slug":"brett-steele","name":"Brett Steele","time":195.92,"topicId":"personality","topicLabel":"Personality"},{"slug":"brett-steele","name":"Brett Steele","time":388.16,"topicId":"influence","topicLabel":"Influence"},{"slug":"brett-steele","name":"Brett Steele","time":483.92,"topicId":"office","topicLabel":"Office"},{"slug":"brett-steele","name":"Brett Steele","time":636.36,"topicId":"building","topicLabel":"Building"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":3.32,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":527.72,"topicId":"scene","topicLabel":"Scene"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":657.92,"topicId":"architecture","topicLabel":"Architecture"},{"slug":"john-frazer","name":"John Frazer","time":764.56,"topicId":"technology","topicLabel":"Technology"},{"slug":"max-neal","name":"Max Neal","time":453.08,"topicId":"office","topicLabel":"Office"},{"slug":"max-neal","name":"Max Neal","time":641.96,"topicId":"network","topicLabel":"Network"},{"slug":"paul-finch","name":"Paul Finch","time":1068.04,"topicId":"conscience","topicLabel":"Conscience"},{"slug":"paul-finch","name":"Paul Finch","time":1965.44,"topicId":"present","topicLabel":"Present"},{"slug":"peter-murray","name":"Peter Murray","time":295.64,"topicId":"personality","topicLabel":"Personality"},{"slug":"peter-murray","name":"Peter Murray","time":636