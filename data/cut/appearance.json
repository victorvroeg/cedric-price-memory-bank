ikipedia.org/wiki/Architecture\">architecture</a> in the UK and one of the most prestigious and competitive in the world. Its wide-ranging programme of exhibitions, lectures, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Academic_conference\">symposia</a> and publications have given it a central position in global discussions and developments within contemporary architectural culture.","subtitle":"Architectural Association School of Architecture","image":"/cedric-price-memory-bank/cards/aa.jpg","external":"http://www.aaschool.ac.uk","location":"https://www.google.com/maps/place/36+Bedford+Square,+AA+School+of+Architecture,+Fitzrovia,+London+WC1B+3ES,+UK/@51.5183066,-0.1307022,17z","also":[{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":702,"topicId":"scene","topicLabel":"Scene"},{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":1172.2,"topicId":"network","topicLabel":"Network"},{"slug":"brett-steele","name":"Brett Steele","time":195.92,"topicId":"personality","topicLabel":"Personality"},{"slug":"brett-steele","name":"Brett Steele","time":388.16,"topicId":"influence","topicLabel":"Influence"},{"slug":"brett-steele","name":"Brett Steele","time":483.92,"topicId":"office","topicLabel":"Office"},{"slug":"brett-steele","name":"Brett Steele","time":636.36,"topicId":"building","topicLabel":"Building"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":3.32,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":527.72,"topicId":"scene","topicLabel":"Scene"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":657.92,"topicId":"architecture","topicLabel":"Architecture"},{"slug":"john-frazer","name":"John Frazer","time":764.56,"topicId":"technology","topicLabel":"Technology"},{"slug":"max-neal","name":"Max Neal","time":453.08,"topicId":"office","topicLabel":"Office"},{"slug":"max-neal","name":"Max Neal","time":641.96,"topicId":"network","topicLabel":"Network"},{"slug":"paul-finch","name":"Paul Finch","time":1068.04,"topicId":"conscience","topicLabel":"Conscience"},{"slug":"paul-finch","name":"Paul Finch","time":1965.44,"topicId":"present","topicLabel":"Present"},{"slug":"peter-murray","name":"Peter Murray","time":295.64,"topicId":"personality","topicLabel":"Personality"},{"slug":"peter-murray","name":"Peter Murray","time":636.52,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"peter-murray","name":"Peter Murray","time":884.76,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":266.96,"topicId":"communications","topicLabel":"Communications"},{"slug":"steve-mullin","name":"Steve Mullin","time":350.88,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"thomas-weaver","name":"Thomas Weaver","time":575,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"thomas-weaver","name":"Thomas Weaver","time":738.8,"topicId":"appearance","topicLabel":"Appearance"},{"slug":"will-alsop","name":"Will Alsop","time":498.32,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"will-alsop","name":"Will Alsop","time":518.88,"topicId":"institutions","topicLabel":"Institutions"}]},"Ludwig Wittgenstein":{"slug":"ludwig-wittgenstein","body":"<p class=\"MsoNormal\" style=\"margin-right: 53.5pt; tab-stops: 0in;\">Ludwig Josef Johann Wittgenstein (26 April 1889 – 29 April 1951) was an Austrian-British philosopher who worked primarily in <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Logic\">logic</a>, the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Philosophy_of_mathematics\">philosophy of mathematics</a>, the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Philosophy_of_mind\">philosophy of mind</a>, and the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Philosophy_of_language\">philosophy of language</a>. From 1929–1947, Wittgenstein taught at the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/University_of_Cambridge\">University of Cambridge</a>. During his lifetime he published just one slim book, the 75-page <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Tractatus_Logico-Philosophicus\">Tractatus Logico-Philosophicus</a> (1921), one article, one book review and a children's dictionary.His voluminous manuscripts were edited and published posthumously. <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Philosophical_Investigations\">Philosophical Investigations</a> appeared as a book in 1953 and by the end of the century it was considered an important modern classic.Philosopher <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Bertrand_Russell\">Bertrand Russell</a> described Wittgenstein as \"the most perfect example I have ever known of genius as traditionally conceived; passionate, profound, intense, and dominating\"</p>","subtitle":null,"image":null,"external":null,"location":null,"also":[{"slug":"paul-barker","name":"Paul Barker","time":1032.04,"topicId":"appearance","topicLabel":"Appearance"}]},"RIBA":{"slug":"riba","body":"The Royal Institute of British Architects (RIBA) is a <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Professional_body\">professional body</a> for architects primarily in the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/United_Kingdom\">United Kingdom</a>, but also internationally, founded for the advancement of architecture under its charter granted in 1837 and Supplemental Charter granted in 1971.","subtitle":"Royal Institute of British Architects","image":"/cedric-price-memory-bank/cards/riba.jpg","external":"http://www.architecture.com","location":"https://maps.google.com/?q=66+Portland+Pl,+London+W1B,+UK","also":[{"slug":"john-frazer","name":"John Frazer","time":460,"topicId":"generator","topicLabel":"GENERATOR"},{"slug":"steve-mullin","name":"Steve Mullin","time":625.52,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"thomas-weaver","name":"Thomas Weaver","time":742.16,"topicId":"appearance","topicLabel":"Appearance"}]},"White Collar":{"slug":"white-collar","body":"Typical Cedric Price appearance","subtitle":"X","image":"/cedric-price-memory-bank/cards/white-collar.jpg","external":"X","location":"https://maps.google.com/?q=38+Alfred+Pl,+London+WC1E,+UK","also":[{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":297.36,"topicId":"englishness","topicLabel":"Englishness"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":971.44,"topicId":"person","topicLabel":"Person"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":47.64,"topicId":"appearance","topicLabel":"Appearance"},{"slug":"max-neal","name":"Max Neal","time":39.92,"topicId":"office","topicLabel":"Office"},{"slug":"paul-barker","name":"Paul Barker","time":1047.72,"topicId":"appearance","topicLabel":"Appearance"},{"slug":"peter-murray","name":"Peter Murray","time":79.84,"topicId":"appearance","topicLabel":"Appearance"}]}}}