7,"end":1329,"topicId":"enabling","segments":[{"start":1237,"end":1329,"topicId":"enabling"}],"cards":[{"time":1300.44,"title":"InterAction Centre","id":"interaction-centre"}]},{"slug":"samantha-hardingham","name":"Samantha Hardingham","jobtitle":"Architectural writer and editor","recorded":"2014-10-30","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/8f6f7744b941fb8eae6c60abd85ab5da/manifest/video.m3u8","start":1182,"end":1311,"topicId":"enabling","segments":[{"start":1182,"end":1311,"topicId":"enabling"}],"cards":[{"time":1272.88,"title":"GENERATOR","id":"generator"}]},{"slug":"thomas-weaver","name":"Thomas Weaver","jobtitle":"Architectural writer and editor","recorded":"2014-11-05","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/939360abb6f6477d596ff7cbf0905708/manifest/video.m3u8","start":890,"end":932,"topicId":"enabling","segments":[{"start":890,"end":932,"topicId":"enabling"}],"cards":[]},{"slug":"will-alsop","name":"Will Alsop","jobtitle":"Former member of the office, architect","recorded":"2014-11-05","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/005dfe1884685dc09eac01133744f2ef/manifest/video.m3u8","start":969,"end":1060,"topicId":"enabling","segments":[{"start":969,"end":1060,"topicId":"enabling"}],"cards":[]}],"cards":{"FUN PALACE":{"slug":"fun-palace","body":"Fun Palace is Cedric Price’s most celebrated work. Whether characterised as a giant toy or as a building-sized transformable machine, the project’s interest resides in its radical reliance on structure and technology, its exemplification of notions of time-based and anticipatory architecture. With Fun Palace, Price addressed social and political issues that go far beyond the typical bounds of architecture. Fun Palace was conceived and commissioned in 1961 by renowned theatre director and producer Joan Littlewood. Price developed plans for the project through 1964, both for the main project and for a smaller, more mobile “pilot” project. Neither were realised. Attempts to get planning permission for a wide variety of sites within and around London continued through 1970, amidst opposition from church, citizen groups and confounded city councils.","subtitle":"Laboratory of Fun and a University of the Streets","image":"/cedric-price-memory-bank/cards/fun-palace.jpg","external":"http://www.cca.qc.ca/en/collection/283-cedric-price-fun-palace","location":"https://www.google.com/maps/place/London,+UK/@51.518722,-0.0007261,13z","also":[{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":139.88,"topicId":"thinking","topicLabel":"Thinking"},{"slug":"brett-steele","name":"Brett Steele","time":464.08,"topicId":"office","topicLabel":"Office"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":647.24,"topicId":"architecture","topicLabel":"Architecture"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":11,"topicId":"present","topicLabel":"Present"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":381,"topicId":"office","topicLabel":"Office"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":671.76,"topicId":"time","topicLabel":"Time"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":1034.84,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":1547.08,"topicId":"present","topicLabel":"Present"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":414.28,"topicId":"building","topicLabel":"Building"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1021.72,"topicId":"enabling","topicLabel":"Enabling"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1036.76,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1132.72,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"john-frazer","name":"John Frazer","time":873.92,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"john-frazer","name":"John Frazer","time":1684.84,"topicId":"thinking","topicLabel":"Thinking"},{"slug":"max-neal","name":"Max Neal","time":744.8,"topicId":"enabling","topicLabel":"Enabling"},{"slug":"max-neal","name":"Max Neal","time":796.08,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"max-neal","name":"Max Neal","time":883.28,"topicId":"influence","topicLabel":"Influence"},{"slug":"paul-finch","name":"Paul Finch","time":676.6,"topicId":"building","topicLabel":"Building"},{"slug":"paul-finch","name":"Paul Finch","time":1117.36,"topicId":"thinking","topicLabel":"Thinking"},{"slug":"paul-finch","name":"Paul Finch","time":1903.76,"topicId":"present","topicLabel":"Present"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":651.64,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"steve-mullin","name":"Steve Mullin","time":83.44,"topicId":"office","topicLabel":"Office"},{"slug":"steve-mullin","name":"Steve Mullin","time":138.8,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"steve-mullin","name":"Steve Mullin","time":637.8,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"steve-mullin","name":"Steve Mullin","time":681.84,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"steve-mullin","name":"Steve Mullin","time":1943.6,"topicId":"drawing","topicLabel":"Drawing"},{"slug":"will-alsop","name":"Will Alsop","time":1104.36,"topicId":"fun-palace","topicLabel":"FUN PALACE"}]},"GENERATOR":{"slug":"generator","body":"The Generator, an early investigation into artificially intelligent architecture, was designed with no specific program, but only a desired end-effect, in mind. The project was commissioned by Howard Gilman for a site at the Gilman Paper Corporation's White Oak Plantation in Florida to provide a facility to house dance, theater, and visiting artists. Cedric Price explored a type of architecture that, like medicine, would operate less as a remedy for the ills of society and more as a preventive system, creating flexible conditions previously thought impossible within a socially beneficial environment.","subtitle":"Faculty of Architecture","image":"/cedric-price-memory-bank/cards/generator.jpg","external":"http://www.moma.org/collection/object.php?object_id=895","location":"https://www.google.com/maps/place/White+Oak,+GA+31568,+USA/@31.0313095,-81.7339961,13z","also":[{"slug":"john-frazer","name":"John Frazer","time":219.32,"topicId":"generator","topicLabel":"GENERATOR"},{"slug":"john-frazer","name":"John Frazer","time":426.44,"topicId":"generator","topicLabel":"GENERATOR"},{"slug":"john-frazer","name":"John Frazer","time":658.12,"topicId":"conscience","topicLabel":"Conscience"},{"slug":"john-frazer","name":"John Frazer","time":786.36,"topicId":"technology","topicLabel":"Technology"},{"slug":"john-frazer","name":"John Frazer","time":1683.8,"topicId":"thinking","topicLabel":"Thinking"},{"slug":"john-frazer","name":"John Frazer","time":1709.08,"topicId":"generator","topicLabel":"GENERATOR"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":677.68,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":1272.88,"topicId":"enabling","topicLabel":"Enabling"}]},"InterAction Centre":{"slug":"interaction-centre","body":"The failure of the Fun Palace was not the end of Price's attempts to realize an interactive and improvisational architecture. In 1976, he built a greatly reduced version of the Fun Palace in Kentish Town. Known as the InterAction Centre, this design incorporated many of the features and innovations of the Fun Palace, though on a smaller scale. It was demolished in 2003.","subtitle":"Kentish Town","image":"/cedric-price-memory-bank/cards/interaction-centre.jpg","external":"http://www.audacity.org/SM-26-11-07-02.htm","location":"https://www.google.com/maps/place/Kentish+Town/@51.55031,-0.14071,14z","also":[{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":500.68,"topicId":"thinking","topicLabel":"Thinking"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":411.76,"topicId":"building","topicLabel":"Building"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":580.12,"topicId":"interaction-centre","topicLabel":"INTERACTION CENTRE"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1022.52,"topicId":"enabling","topicLabel":"Enabling"},{"slug":"paul-finch","name":"Paul Finch","time":632.24,"topicId":"building","topicLabel":"Building"},{"slug":"peter-murray","name":"Peter Murray","time":1300.44,"topicId":"enabling","topicLabel":"Enabling"},{"slug":"will-alsop","name":"Will Alsop","time":15.88,"topicId":"interaction-centre","topicLabel":"INTERACTION CENTRE"}]},"Magnet":{"slug":"magnet","body":"Magnet was <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Cedric_Price\">Cedric Price</a>'s latest project. It proposed ten short life structures for cities which would provide public amenities and stimulate new patterns of public movement. Demonstrating his ideas of 'anticipatory architecture,' the Magnets were designed as temporary, mobile, structural adjustments to the public realm.  The Magnets included Stairways, Promenade, Arcade and Pier. They would improve access, allow better views of the urban landscape and create new public spaces as well as increasing the use of existing spaces. The exhibition at The Architecture Foundation was designed by Price and afforded the first opportunity to look at his drawings and to guess at the possibilities that the Magnets might have provided.","subtitle":"Project","image":"/cedric-price-memory-bank/cards/magnet.jpg","external":"http://www.architecturefoundation.org.uk/programme/1997/magnet-cedric-price","location":"https://www.google.com/maps/search/london+south+bank/@51.509549,-0.1084786,15z","also":[{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":982.72,"topicId":"enabling","topicLabel":"Enabling"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":712.56,"topicId":"influence","topicLabel":"Influence"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1024,"topicId":"enabling","topicLabel":"Enabling"},{"slug":"paul-finch","name":"Paul Finch","time":792.72,"topicId":"magnet","topicLabel":"MAGNET"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":685.2,"topicId":"fun-palace","topicLabel":"FUN PALACE"}]},"South Bank":{"slug":"south-bank","body":"In 1984 Price proposed the redevelopment of London's <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/South_Bank\">South Bank</a>, and foresaw the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/London_Eye\">London Eye</a> by suggesting that a giant <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Ferris_wheel\">Ferris wheel</a> should be constructed by the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/River_Thames\">River Thames</a>.\r\n\r\n“A city should be sufficiently old, rich and well-serviced to be able to accommodate a vast range of disparate, peculiar, incomparable objects, space, activities and people. The resultant mix, to be both convivial and convenient, is achieved through constant change in community appetites and individual mores – and not through a Band-Aid of architectural ingenuity trying to be all things to all men…”\r\n\r\n(Price Probes, BD, 16 September 1994)<!--more-->","subtitle":"Job no. 159","image":null,"external":"http://www.aaschool.ac.uk/PUBLIC/AAPUBLICATIONS/aboutpublications\n.php","location":"https://maps.google.com/?q=london+eye","also":[{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":20.56,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":837.4,"topicId":"enabling","topicLabel":"Enabling"},{"slug":"max-neal","name":"Max Neal","time":203.56,"topicId":"building","topicLabel":"Building"},{"slug":"max-neal","name":"Max Neal","time":485,"topicId":"southbank","topicLabel":"SOUTHBANK"}]}}}