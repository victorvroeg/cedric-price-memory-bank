2/manifest/video.m3u8","start":986,"end":1079,"topicId":"conscience","segments":[{"start":986,"end":1079,"topicId":"conscience"}],"cards":[{"time":1063.84,"title":"Cedric Price Office","id":"cedric-price-office"},{"time":1068.04,"title":"AA","id":"aa"}]},{"slug":"will-alsop","name":"Will Alsop","jobtitle":"Former member of the office, architect","recorded":"2014-11-05","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/005dfe1884685dc09eac01133744f2ef/manifest/video.m3u8","start":1291,"end":1390,"topicId":"conscience","segments":[{"start":1291,"end":1390,"topicId":"conscience"}],"cards":[{"time":1328.16,"title":"Vienna University of Technology","id":"vienna-university-of-technology"},{"time":1356.68,"title":"Archigram","id":"archigram"}]}],"cards":{"AA":{"slug":"aa","body":"The Architectural Association School of Architecture in London, commonly referred to as the AA, is the oldest independent school of <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Architecture\">architecture</a> in the UK and one of the most prestigious and competitive in the world. Its wide-ranging programme of exhibitions, lectures, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Academic_conference\">symposia</a> and publications have given it a central position in global discussions and developments within contemporary architectural culture.","subtitle":"Architectural Association School of Architecture","image":"/cedric-price-memory-bank/cards/aa.jpg","external":"http://www.aaschool.ac.uk","location":"https://www.google.com/maps/place/36+Bedford+Square,+AA+School+of+Architecture,+Fitzrovia,+London+WC1B+3ES,+UK/@51.5183066,-0.1307022,17z","also":[{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":702,"topicId":"scene","topicLabel":"Scene"},{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":1172.2,"topicId":"network","topicLabel":"Network"},{"slug":"brett-steele","name":"Brett Steele","time":195.92,"topicId":"personality","topicLabel":"Personality"},{"slug":"brett-steele","name":"Brett Steele","time":388.16,"topicId":"influence","topicLabel":"Influence"},{"slug":"brett-steele","name":"Brett Steele","time":483.92,"topicId":"office","topicLabel":"Office"},{"slug":"brett-steele","name":"Brett Steele","time":636.36,"topicId":"building","topicLabel":"Building"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":3.32,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":527.72,"topicId":"scene","topicLabel":"Scene"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":657.92,"topicId":"architecture","topicLabel":"Architecture"},{"slug":"john-frazer","name":"John Frazer","time":764.56,"topicId":"technology","topicLabel":"Technology"},{"slug":"max-neal","name":"Max Neal","time":453.08,"topicId":"office","topicLabel":"Office"},{"slug":"max-neal","name":"Max Neal","time":641.96,"topicId":"network","topicLabel":"Network"},{"slug":"paul-finch","name":"Paul Finch","time":1068.04,"topicId":"conscience","topicLabel":"Conscience"},{"slug":"paul-finch","name":"Paul Finch","time":1965.44,"topicId":"present","topicLabel":"Present"},{"slug":"peter-murray","name":"Peter Murray","time":295.64,"topicId":"personality","topicLabel":"Personality"},{"slug":"peter-murray","name":"Peter Murray","time":636.52,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"peter-murray","name":"Peter Murray","time":884.76,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":266.96,"topicId":"communications","topicLabel":"Communications"},{"slug":"steve-mullin","name":"Steve Mullin","time":350.88,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"thomas-weaver","name":"Thomas Weaver","time":575,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"thomas-weaver","name":"Thomas Weaver","time":738.8,"topicId":"appearance","topicLabel":"Appearance"},{"slug":"will-alsop","name":"Will Alsop","time":498.32,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"will-alsop","name":"Will Alsop","time":518.88,"topicId":"institutions","topicLabel":"Institutions"}]},"Archigram":{"slug":"archigram","body":"Archigram was an <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Avant-garde\">avant-garde</a> architectural group formed in the 1960s - based at the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Architectural_Association_School_of_Architecture\">Architectural Association</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/London\">London</a> - that was <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Neofuturistic\">neofuturistic</a>, anti-heroic and pro-consumerist, drawing inspiration from technology in order to create a new reality that was solely expressed through hypothetical projects. The main members of the group were <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Peter_Cook_(architect)\">Peter Cook</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/w/index.php?title=Warren_Chalk&amp;action=edit&amp;redlink=1\">Warren Chalk</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Ron_Herron\">Ron Herron</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/w/index.php?title=Dennis_Crompton&amp;action=edit&amp;redlink=1\">Dennis Crompton</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Michael_Webb_(architect)\">Michael Webb</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/w/index.php?title=David_Greene_(architect)&amp;action=edit&amp;redlink=1\">David Greene</a>.","subtitle":"Peter Cook, Warren Chalk, Ron Herron, Dennis Crompton, Michael Webb and David Greene","image":"/cedric-price-memory-bank/cards/archigram.jpg","external":"http://designmuseum.org/design/archigram","location":"https://www.google.com/maps/place/36+Bedford+Square,+AA+School+of+Architecture,+Fitzrovia,+London+WC1B+3ES,+UK/@51.5183066,-0.1307022,17z","also":[{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":770.36,"topicId":"scene","topicLabel":"Scene"},{"slug":"john-frazer","name":"John Frazer","time":344.88,"topicId":"generator","topicLabel":"GENERATOR"},{"slug":"john-frazer","name":"John Frazer","time":1125.6,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"john-frazer","name":"John Frazer","time":1192.04,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"thomas-weaver","name":"Thomas Weaver","time":644.08,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"will-alsop","name":"Will Alsop","time":1356.68,"topicId":"conscience","topicLabel":"Conscience"}]},"Cedric Price Office":{"slug":"cedric-price-office","body":"","subtitle":null,"image":null,"external":null,"location":null,"also":[{"slug":"brett-steele","name":"Brett Steele","time":444.04,"topicId":"office","topicLabel":"Office"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1751.88,"topicId":"office","topicLabel":"Office"},{"slug":"john-frazer","name":"John Frazer","time":43.4,"topicId":"drawing","topicLabel":"Drawing"},{"slug":"max-neal","name":"Max Neal","time":1.64,"topicId":"office","topicLabel":"Office"},{"slug":"max-neal","name":"Max Neal","time":314.44,"topicId":"office","topicLabel":"Office"},{"slug":"max-neal","name":"Max Neal","time":442.6,"topicId":"office","topicLabel":"Office"},{"slug":"paul-barker","name":"Paul Barker","time":184.12,"topicId":"pop-up-parliament","topicLabel":"POP UP PARLIAMENT"},{"slug":"paul-barker","name":"Paul Barker","time":247.32,"topicId":"pop-up-parliament","topicLabel":"POP UP PARLIAMENT"},{"slug":"paul-barker","name":"Paul Barker","time":1065.2,"topicId":"office","topicLabel":"Office"},{"slug":"paul-finch","name":"Paul Finch","time":1063.84,"topicId":"conscience","topicLabel":"Conscience"},{"slug":"peter-murray","name":"Peter Murray","time":272.16,"topicId":"personality","topicLabel":"Personality"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":181.32,"topicId":"office","topicLabel":"Office"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":466.6,"topicId":"office","topicLabel":"Office"},{"slug":"steve-mullin","name":"Steve Mullin","time":26.88,"topicId":"personality","topicLabel":"Personality"},{"slug":"steve-mullin","name":"Steve Mullin","time":716.28,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"steve-mullin","name":"Steve Mullin","time":743.6,"topicId":"office","topicLabel":"Office"},{"slug":"steve-mullin","name":"Steve Mullin","time":1639.24,"topicId":"housing-research","topicLabel":"HOUSING RESEARCH"},{"slug":"will-alsop","name":"Will Alsop","time":2.64,"topicId":"interaction-centre","topicLabel":"INTERACTION CENTRE"},{"slug":"will-alsop","name":"Will Alsop","time":568.32,"topicId":"office","topicLabel":"Office"},{"slug":"will-alsop","name":"Will Alsop","time":672,"topicId":"office","topicLabel":"Office"},{"slug":"will-alsop","name":"Will Alsop","time":761.16,"topicId":"office","topicLabel":"Office"}]},"GENERATOR":{"slug":"generator","body":"The Generator, an early investigation into artificially intelligent architecture, was designed with no specific program, but only a desired end-effect, in mind. The project was commissioned by Howard Gilman for a site at the Gilman Paper Corporation's White Oak Plantation in Florida to provide a facility to house dance, theater, and visiting artists. Cedric Price explored a type of architecture that, like medicine, would operate less as a remedy for the ills of society and more as a preventive system, creating flexible conditions previously thought impossible within a socially beneficial environment.","subtitle":"Faculty of Architecture","image":"/cedric-price-memory-bank/cards/generator.jpg","external":"http://www.moma.org/collection/object.php?object_id=895","location":"https://www.google.com/maps/place/White+Oak,+GA+31568,+USA/@31.0313095,-81.7339961,13z","also":[{"slug":"john-frazer","name":"John Frazer","time":219.32,"topicId":"generator","topicLabel":"GENERATOR"},{"slug":"john-frazer","name":"John Frazer","time":426.44,"topicId":"generator","topicLabel":"GENERATOR"},{"slug":"john-frazer","name":"John Frazer","time":658.12,"topicId":"conscience","topicLabel":"Conscience"},{"slug":"john-frazer","name":"John Frazer","time":786.36,"topicId":"technology","topicLabel":"Technology"},{"slug":"john-frazer","name":"John Frazer","time":1683.8,"topicId":"thinking","topicLabel":"Thinking"},{"slug":"john-frazer","name":"John Frazer","time":1709.08,"topicId":"generator","topicLabel":"GENERATOR"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":677.68,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":1272.88,"topicId":"enabling","topicLabel":"Enabling"}]},"London Zoo Aviary":{"slug":"london-zoo-aviary","body":"The Aviary at London Zoo is one of the few built projects, realised in collaboration with the engineer Frank Newby and Lord Snowdon. This aviary has been a landmark on the London skyline since it was built in 1962. It was the first walk-through aviary in existence - pushing the architectural boundaries of its time. This aviary is home to some of the most majestic birds in the world, including white ibis and peacocks.","subtitle":null,"image":null,"external":null,"location":null,"also":[{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":1176.4,"topicId":"delight","topicLabel":"Delight"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":404.24,"topicId":"building","topicLabel":"Building"},{"slug":"john-frazer","name":"John Frazer","time":1366.32,"topicId":"conscience","topicLabel":"Conscience"},{"slug":"paul-finch","name":"Paul Finch","time":662.72,"topicId":"building","topicLabel":"Building"},{"slug":"paul-finch","name":"Paul Finch","time":713.16,"topicId":"time","topicLabel":"Time"},{"slug":"steve-mullin","name":"Steve Mullin","time":1719.8,"topicId":"network","topicLabel":"Network"},{"slug":"thomas-weaver","name":"Thomas Weaver","time":982.08,"topicId":"architecture","topicLabel":"Architecture"}]},"Monica Pidgeon":{"slug":"monica-pidgeon","body":"<p class=\"MsoNormal\">Monica Pidgeon, who has died aged 95, was a pivotal figure in the world of postwar modern architecture. She edited the Bloomsbury-based international journal Architectural Design (AD) from 1946 until 1975, publishing and championing the work of major modernist figures such as <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.theguardian.com/artanddesign/lecorbusier\">Le Corbusier</a>, Josep Lluís Sert, Mies van der Rohe, Walter Gropius, Richard Buckminster Fuller and Alison and Peter Smithson.</p>","subtitle":"Architectural editor","image":"/cedric-price-memory-bank/cards/monica-pidgeon.jpg","external":"http://www.theguardian.com/artanddesign/2009/sep/21/monica-pidgeon-obituary","location":"https://www.google.com/maps/place/London,+UK","also":[{"slug":"john-frazer","name":"John Frazer","time":653.08,"topicId":"conscience","topicLabel":"Conscience"},{"slug":"max-neal","name":"Max Neal","time":410.16,"topicId":"office","topicLabel":"Office"}]},"Peter Cook":{"slug":"peter-cook","body":"Professor Sir Peter Cook RA, founder of Archigram, former Director the Institute for Contemporary Art, London (the ICA) and Bartlett School of Architecture at University Col- lege, London has been a pivotal figure within the global architectural world for over half a century. His ongoing contribution to architectural innovation was most recent- ly recognised via the conferral of an honorary doctorate in April 2010, by the University of Lund, Sweden.","subtitle":"Archigram","image":"/cedric-price-memory-bank/cards/peter-cook.jpg","external":"http://www.crab-studio.com/assets/cv-p.cook%2c-g.-robotham.pdf","location":"https://maps.google.com/?q=Crab+Studio","also":[{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":1080.88,"topicId":"delight","topicLabel":"Delight"},{"slug":"john-frazer","name":"John Frazer","time":1197.4,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"john-frazer","name":"John Frazer","time":1355.16,"topicId":"conscience","topicLabel":"Conscience"}]},"Rem Koolhaas":{"slug":"rem-koolhaas","body":"Rem Koolhaas founded OMA in 1975 together with Elia and Zoe Zenghelis and Madelon Vriesendorp. He graduated from the Architectural Association in London and in 1978 published Delirious New York: A Retroactive Manifesto for Manhattan. In 1995, his book S,M,L,XL summarized the work of OMA in \"a novel about architecture\". He heads the work of both OMA and AMO, the research branch of OMA, operating in areas beyond the realm of architecture such as media, politics, renewable energy and fashion. Koolhaas has won several international awards including the Pritzker Architecture Prize in 2000, the Golden Lion for Lifetime Achievement at the 2010 Venice Biennale, the RIBA Charles Jencks Award in 2012, and the Johannes Vermeer Prijs in 2013. Koolhaas is a professor at Harvard University where he conducts the Project on the City. This year, he is the director of the 14th International Architecture Exhibition of the Venice Biennale, entitled Fundamentals.","subtitle":"OMA","image":"/cedric-price-memory-bank/cards/rem-koolhaas.jpg","external":"http://www.oma.eu/partners","location":"https://maps.google.com/?q=Stichting+Vangnet+O.M.A.","also":[{"slug":"brett-steele","name":"Brett Steele","time":683.92,"topicId":"thinking","topicLabel":"Thinking"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":44.92,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":71.52,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":983.68,"topicId":"person","topicLabel":"Person"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":1065.6,"topicId":"delight","topicLabel":"Delight"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":17,"topicId":"present","topicLabel":"Present"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":291.92,"topicId":"person","topicLabel":"Person"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":685,"topicId":"time","topicLabel":"Time"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":780.84,"topicId":"architecture","topicLabel":"Architecture"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":2408.64,"topicId":"present","topicLabel":"Present"},{"slug":"john-frazer","name":"John Frazer","time":1327.96,"topicId":"conscience","topicLabel":"Conscience"},{"slug":"thomas-weaver","name":"Thomas Weaver","time":984.36,"topicId":"architecture","topicLabel":"Architecture"}]},"Roy Landau":{"slug":"roy-landau","body":"As director of graduate studies at the Architectural Association from 1974-93, Royston \"Roy\" Landau, was part of the process that turned the London centre from a fine, but limited, professional school of architecture into an international powerhouse. It was the inseparability of architecture and ideas that was the premise that led him into teaching at the AA from 1961 onwards, in an independent school of architecture, self-consciously democratic and unintentionally elitist, packed with brilliant students, and a young faculty that constituted a galaxy of talent. What made him stand out was not just his intensity and rigour, but the range of his interests.","subtitle":"Director of Graduate Studies, Architectural Association","image":"/cedric-price-memory-bank/cards/roy-landau.jpg","external":"http://www.theguardian.com/news/2001/nov/20/guardianobituaries.highereducation","location":"https://www.google.com/maps/place/36+Bedford+Square,+AA+School+of+Architecture,+Fitzrovia,+London+WC1B+3ES,+UK/@51.5183066,-0.1307022,17z","also":[{"slug":"john-frazer","name":"John Frazer","time":17.36,"topicId":"conscience","topicLabel":"Conscience"},{"slug":"john-frazer","name":"John Frazer","time":1426.48,"topicId":"thinking","topicLabel":"Thinking"}]},"Vienna University of Technology":{"slug":"vienna-university-of-technology","body":"The Vienna University of Technology is one of the major universities in <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Vienna\">Vienna</a>, the capital of Austria. Founded in 1815 as the \"Imperial-Royal Polytechnic Institute\", it currently has about 26,200 students (19% foreign students/30% women), eight faculties and about 4,000 staff members (1,800 academics). The university's teaching and research is focused on <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Engineering\">engineering</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Natural_science\">natural sciences</a>.","subtitle":"Technische Universität Wien","image":"/cedric-price-memory-bank/cards/vienna-university-of-technology.jpg","external":"http://www.tuwien.ac.at/en/tuwien_home/","location":"https://www.google.com/maps/place/Vienna+University+of+Technology/@48.198655,16.368463,17z","also":[{"slug":"will-alsop","name":"Will Alsop","time":1328.16,"topicId":"conscience","topicLabel":"Conscience"}]}}}