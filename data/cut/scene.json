{"slug":"scene","label":"Scene","colour":"#A1E0FF","items":[{"slug":"bernard-tschumi","name":"Bernard Tschumi","jobtitle":"Architect","recorded":"2014-11-05","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/e6455559dcde439790dacda78cb12731/manifest/video.m3u8","start":644,"end":804,"topicId":"scene","segments":[{"start":644,"end":804,"topicId":"scene"}],"cards":[{"time":702,"title":"AA","id":"aa"},{"time":770.36,"title":"Archigram","id":"archigram"}]},{"slug":"bernard-tschumi","name":"Bernard Tschumi","jobtitle":"Architect","recorded":"2014-11-05","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/e6455559dcde439790dacda78cb12731/manifest/video.m3u8","start":978,"end":1091,"topicId":"scene","segments":[{"start":978,"end":1091,"topicId":"scene"}],"cards":[]},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","jobtitle":"Architect and educator","recorded":"2014-11-05","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/42dccd275829cdb3e132d873695d949d/manifest/video.m3u8","start":502,"end":634,"topicId":"scene","segments":[{"start":502,"end":634,"topicId":"scene"}],"cards":[{"time":527.72,"title":"AA","id":"aa"}]}],"cards":{"AA":{"slug":"aa","body":"The Architectural Association School of Architecture in London, commonly referred to as the AA, is the oldest independent school of <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Architecture\">architecture</a> in the UK and one of the most prestigious and competitive in the world. Its wide-ranging programme of exhibitions, lectures, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Academic_conference\">symposia</a> and publications have given it a central position in global discussions and developments within contemporary architectural culture.","subtitle":"Architectural Association School of Architecture","image":"/cedric-price-memory-bank/cards/aa.jpg","external":"http://www.aaschool.ac.uk","lo