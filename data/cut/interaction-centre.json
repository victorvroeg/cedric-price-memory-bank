{"slug":"interaction-centre","label":"INTERACTION CENTRE","colour":"#A1E0FF","items":[{"slug":"jeremy-melvin","name":"Jeremy Melvin","jobtitle":"Journalist, writer, curator","recorded":"2014-11-05","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/2c2318e3565810cfb3557ff7f69cd5d9/manifest/video.m3u8","start":579,"end":666,"topicId":"interaction-centre","segments":[{"start":579,"end":666,"topicId":"interaction-centre"}],"cards":[{"time":580.12,"title":"InterAction Centre","id":"interaction-centre"},{"time":593.8,"title":"Listed Building","id":"listed-building"},{"time":624.08,"title":"BD","id":"bd"},{"time":625.8,"title":"Paul Finch","id":"paul-finch"}]},{"slug":"will-alsop","name":"Will Alsop","jobtitle":"Former member of the office, architect","recorded":"2014-11-05","hls":"https://customer-syg1o9n270h63juf.cloudflarestream.com/005dfe1884685dc09eac01133744f2ef/manifest/video.m3u8","start":0,"end":392,"topicId":"interaction-centre","segments":[{"start":0,"end":392,"topicId":"interaction-centre"}],"cards":[{"time":2.64,"title":"Cedric Price Office","id":"cedric-price-office"},{"time":15.88,"title":"InterAction Centre","id":"interaction-centre"}]}],"cards":{"BD":{"slug":"bd","body":"Building Design, or BD, is a weekly <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Architecture\">architectural</a> magazine and digital title in the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/United_Kingdom\">United Kingdom</a>. BD was launched in 1970 by publisher Morgan Grampian as a closed circulation weekly as <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/High-tech_architecture\">high-tech architecture</a> was just starting to take-off. It ceased its print edition in March 2014, remaining a digital only publication. The title soon carved a special niche for itself because of the extent of its news coverage, range of job adverts as well as its campaigning voice. Its tabloid format and news based content has earned it the reputation as one of the UK's best business titles leading to a clutch of industry awards. It is the most requested title in the library of the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Royal_Institute_of_British_Architects\">Royal Institute of British Architects</a>. Unlike most other architectural publications BD’s editors, with a few exceptions, are journalists not architects.","subtitle":null,"image":null,"external":null,"location":null,"also":[{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":624.08,"topicId":"interaction-centre","topicLabel":"INTERACTION CENTRE"},{"slug":"john-frazer","name":"John Frazer","time":593.04,"topicId":"generator","topicLabel":"GENERATOR"},{"slug":"paul-finch","name":"Paul Finch","time":275.88,"topicId":"communications","topicLabel":"Communications"},{"slug":"paul-finch","name":"Paul Finch","time":851.52,"topicId":"network","topicLabel":"Network"},{"slug":"paul-finch","name":"Paul Finch","time":1500.24,"topicId":"communications","topicLabel":"Communications"},{"slug":"peter-murray","name":"Peter Murray","time":188.16,"topicId":"personality","topicLabel":"Personality"}]},"Cedric Price Office":{"slug":"cedric-price-office","body":"","subtitle":null,"image":null,"external":null,"location":null,"also":[{"slug":"brett-steele","name":"Brett Steele","time":444.04,"topicId":"office","topicLabel":"Office"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1751.88,"topicId":"office","topicLabel":"Office"},{"slug":"john-frazer","name":"John Frazer","time":43.4,"topicId":"drawing","topicLabel":"Drawing"},{"slug":"max-neal","name":"Max Neal","time":1.64,"topicId":"office","topicLabel":"Office"},{"slug":"max-neal","name":"Max Neal","time":314.44,"topicId":"office","topicLabel":"Office"},{"slug":"max-neal","name":"Max Neal","time":442.6,"topicId":"office","topicLabel":"Office"},{"slug":"paul-barker","name":"Paul Barker","time":18