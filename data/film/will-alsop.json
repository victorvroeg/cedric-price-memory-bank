"time":874.8,"title":"Smarties","id":"smarties"},{"time":877.08,"title":"The White Room","id":"the-white-room"},{"time":896.04,"title":"Escape from Colditz","id":"escape-from-colditz"},{"time":1092.64,"title":"Richard Meier","id":"richard-meier"},{"time":1102.68,"title":"Joan Littlewood","id":"joan-littlewood"},{"time":1104.36,"title":"FUN PALACE","id":"fun-palace"},{"time":1157.08,"title":"Pompidou Centre","id":"pompidou-centre"},{"time":1174.04,"title":"Richard Rogers","id":"richard-rogers"},{"time":1175.68,"title":"Renzo Piano","id":"renzo-piano"},{"time":1239.44,"title":"Labour Party","id":"labour-party"},{"time":1260.8,"title":"McAppy","id":"mcappy"},{"time":1328.16,"title":"Vienna University of Technology","id":"vienna-university-of-technology"},{"time":1356.68,"title":"Archigram","id":"archigram"}]}],"cards":{"AA":{"slug":"aa","body":"The Architectural Association School of Architecture in London, commonly referred to as the AA, is the oldest independent school of <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Architecture\">architecture</a> in the UK and one of the most prestigious and competitive in the world. Its wide-ranging programme of exhibitions, lectures, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Academic_conference\">symposia</a> and publications have given it a central position in global discussions and developments within contemporary architectural culture.","subtitle":"Architectural Association School of Architecture","image":"/cedric-price-memory-bank/cards/aa.jpg","external":"http://www.aaschool.ac.uk","location":"https://www.google.com/maps/place/36+Bedford+Square,+AA+School+of+Architecture,+Fitzrovia,+London+WC1B+3ES,+UK/@51.5183066,-0.1307022,17z","also":[{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":702,"topicId":"scene","topicLabel":"Scene"},{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":1172.2,"topicId":"network","topicLabel":"Network