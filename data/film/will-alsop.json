"institutions","topicLabel":"Institutions"},{"slug":"thomas-weaver","name":"Thomas Weaver","time":738.8,"topicId":"appearance","topicLabel":"Appearance"},{"slug":"will-alsop","name":"Will Alsop","time":498.32,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"will-alsop","name":"Will Alsop","time":518.88,"topicId":"institutions","topicLabel":"Institutions"}]},"Alvin Boyarsky":{"slug":"alvin-boyarsky","body":"From 1971 until his death in 1990, Alvin Boyarsky held autocratic sway over the Architectural Association at Bedford Square, transforming the AA into a major international cultural institution. With the removal from the AA of UK student grants, Boyarsky seized the opportunity, and indeed the necessity, to make the school a global concern, embarking upon a highly ambitious programme of exhibitions, catalogues and publications.","subtitle":"Chairman of the AA","image":"/cedric-price-memory-bank/cards/alvin-boyarsky.jpg","external":"http://www.aaschool.ac.uk/AALIFE/LIBRARY/aahistory.php","location":"https://maps.google.com/?q=36+Bedford+Square,+London+WC1B+3ES,+UK","also":[{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":27.08,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"thomas-weaver","name":"Thomas Weaver","time":614.92,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"will-alsop","name":"Will Alsop","time":504.84,"topicId":"institutions","topicLabel":"Institutions"}]},"Archigram":{"slug":"archigram","body":"Archigram was an <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Avant-garde\">avant-garde</a> architectural group formed in the 1960s - based at the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Architectural_Association_School_of_Architecture\">Architectural Association</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/London\">London</a> - that was <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Neofuturistic\">neofuturistic</a>, anti-heroic and pro-consumerist, drawing inspiration from technology in order to create a new reality that was solely expressed through hypothetical projects. The main members of the group were <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Peter_Cook_(architect)\">Peter Cook</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/w/index.php?title=Warren_Chalk&amp;action=edit&amp;redlink=1\">Warren Chalk</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Ron_Herron\">Ron Herron</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/w/index.php?title=Dennis_Crompton&amp;action=edit&amp;redlink=1\">Dennis Crompton</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Michael_Webb_(architect)\">Michael Webb</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/w/index.php?title=David_Greene_(architect)&amp;action=edit&amp;redlink=1\">David Greene</a>.","subtitle":"Peter Cook, Warren Chalk, Ron Herron, Dennis Crompton, Michael Webb and David Greene","image":"/cedric-price-memory-bank/cards/archigram.jpg","external":"http://designmuseum.org/design/archigram","location":"https://www.google.com/maps/place/36+Bedford+Square,+AA+School+of+Architecture,+Fitzrovia,+London+WC1B+3ES,+UK/@51.5183066,-0.1307022,17z","also":[{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":770.36,"topicId":"scene","topicLabel":"Scene"},{"slug":"john-frazer","name":"John Frazer","time":344.88,"topicId":"generator","topicLabel":"GENERATOR"},{"slug":"john-frazer","name":"John Frazer","time":1125.6,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"john-frazer","name":"John Frazer","time":1192.04,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"thomas-weaver","name":"Thomas Weaver","time":644.08,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"will-alsop","name":"Will Alsop","time":1356.68,"topicId":"conscience","topicLabel":"Conscience"}]},"Cedric Price Office":{"slug":"cedric-price-office","body":"","subtitle":null,"image":null,"external":null,"location":null,"also":[{"slug":"brett-steele","name":"Brett Steele","time":444.04,"topicId":"office","topicLabel":"Office"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1751.88,"topicId":"office","topicLabel":"Office"},{"slug":"john-frazer","name":"John Frazer","time":43.4,"topicId":"drawing","topicLabel":"Drawing"},{"slug":"max-neal","name":"Max Neal","time":1.64,"topicId":"office","topicLabel":"Office"},{"slug":"max-neal","name":"Max Neal","time":314.44,"topicId":"office","topicLabel":"Office"},{"slug":"max-neal","name":"Max Neal","time":442.6,"topicId":"office","topicLabel":"Office"},{"slug":"paul-barker","name":"Paul Barker","time":184.12,"topicId":"pop-up-parliament","topicLabel":"POP UP PARLIAMENT"},{"slug":"paul-barker","name":"Paul Barker","time":247.32,"topicId":"pop-up-parliament","topicLabel":"POP UP PARLIAMENT"},{"slug":"paul-barker","name":"Paul Barker","time":1065.2,"topicId":"office","topicLabel":"Office"},{"slug":"paul-finch","name":"Paul Finch","time":1063.84,"topicId":"conscience","topicLabel":"Conscience"},{"slug":"peter-murray","name":"Peter Murray","time":272.16,"topicId":"personality","topicLabel":"Personality"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":181.32,"topicId":"office","topicLabel":"Office"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":466.6,"topicId":"office","topicLabel":"Office"},{"slug":"steve-mullin","name":"Steve Mullin","time":26.88,"topicId":"personality","topicLabel":"Personality"},{"slug":"steve-mullin","name":"Steve Mullin","time":716.28,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"steve-mullin","name":"Steve Mullin","time":743.6,"topicId":"office","topicLabel":"Office"},{"slug":"steve-mullin","name":"Steve Mullin","time":1639.24,"topicId":"housing-research","topicLabel":"HOUSING RESEARCH"},{"slug":"will-alsop","name":"Will Alsop","time":2.64,"topicId":"interaction-centre","topicLabel":"INTERACTION CENTRE"},{"slug":"will-alsop","name":"Will Alsop","time":568.32,"topicId":"office","topicLabel":"Office"},{"slug":"will-alsop","name":"Will Alsop","time":672,"topicId":"office","topicLabel":"Office"},{"slug":"will-alsop","name":"Will Alsop","time":761.16,"topicId":"office","topicLabel":"Office"}]},"David Allford":{"slug":"david-allford","body":"In an age when famous architects become superstars, it is easy to forget that media personalities are unreliable indicators of architectural abilities. David Allford was not a media personality - although a leading architectural journalist remembers him \"growling splendidly into the microphone\" in a recent radio broadcast when they were both panellists - yet most people in this country have probably experienced a building where his hand can be detected. Among them are Gatwick Airport, several large hospitals including St Thomas' in London and Hull Royal Infirmary, numerous comprehensive schools and offices, Warwick University and Cole Brothers department store in his home town of Sheffield.","subtitle":"Architect","image":"/cedric-price-memory-bank/cards/david-allford.jpg","external":"http://www.independent.co.uk/news/people/obituary-david-allford-1246217.html","location":"https://maps.google.com/?q=London,+UK","also":[{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":312.16,"topicId":"influence","topicLabel":"Influence"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1543.48,"topicId":"food-and-drink","topicLabel":"Food and drink"},{"slug":"max-neal","name":"Max Neal","time":446.92,"topicId":"office","topicLabel":"Office"},{"slug":"steve-mullin","name":"Steve Mullin","time":1237.2,"topicId":"food-and-drink","topicLabel":"Food and drink"},{"slug":"will-alsop","name":"Will Alsop","time":835.36,"topicId":"hot-stuff-club","topicLabel":"Hot Stuff Club"}]},"David Price":{"slug":"david-price","body":"David Price is an architect and planner who collaborated with his older brother Cedric Price as a consultant over the course of three decades, beginning in 1971. Most notably David Price contributed models, under the pseudonym “J. Petto,” to such projects as Munich Olympic Village (1971), Blackpool Zoo Restaurant (1971-73), Southend Roof (1972), Parc de la Villette (1982-83), and the IFCCA Prize Competition for the West Side of Manhattan (1998-99).","subtitle":"Architect &amp; planner","image":"/cedric-price-memory-bank/cards/david-price.jpg","external":"http://www.cca.qc.ca/en/collection/903-an-interview-with-david-price-brother-and-model-maker-to","location":"https://maps.google.com/?q=London,+UK","also":[{"slug":"max-neal","name":"Max Neal","time":648.64,"topicId":"network","topicLabel":"Network"},{"slug":"paul-finch","name":"Paul Finch","time":41.92,"topicId":"network","topicLabel":"Network"},{"slug":"will-alsop","name":"Will Alsop","time":857.68,"topicId":"office","topicLabel":"Office"}]},"Escape from Colditz":{"slug":"escape-from-colditz","body":"Escape from Colditz is a strategy card and dice-based <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Board_game\">board game</a> produced by <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Gibsons_Games\">Gibsons Games</a> and first released in 1973. It was licensed to <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Parker_Brothers\">Parker Brothers</a> in the US in the mid-1970s. The game was devised by successful escaper <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Pat_Reid\">Pat Reid</a>, based on the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Prisoner-of-war\">prisoner-of-war</a> camp (<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Oflag_IV-C\">Oflag IV-C</a>) at <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Colditz_Castle\">Colditz Castle</a> in <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Germany\">Germany</a> during <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/World_War_II\">World War II</a>.","subtitle":"Board game","image":"/cedric-price-memory-bank/cards/escape-from-colditz.jpg","external":"http://en.wikipedia.org/wiki/Escape_from_Colditz","location":"https://maps.google.com/?q=UK","also":[{"slug":"will-alsop","name":"Will Alsop","time":896.04,"topicId":"office","topicLabel":"Office"}]},"Frank Newby":{"slug":"frank-newby","body":"Frank Newby (26 March 1926 – 10 May 2001) was one of the leading structural engineers of the 20th century, working with such architects as <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Philip_Powell_(architect)\">Philip Powell</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Hidalgo_Moya\">Hidalgo Moya</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Eero_Saarinen\">Eero Saarinen</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Cedric_Price\">Cedric Price</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/James_Stirling_(architect)\">James Stirling</a>, and the practice of <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Skidmore,_Owings_and_Merrill\">Skidmore, Owings and Merrill</a> (SOM), and such engineers as <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Ove_Arup\">Ove Arup</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Felix_Samuely\">Felix Samuely</a>.","subtitle":"Structural engineer","image":"/cedric-price-memory-bank/cards/frank-newby.jpg","external":"http://en.wikipedia.org/wiki/Frank_Newby","location":"https://maps.google.com/?q=London,+UK","also":[{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":1189.84,"topicId":"delight","topicLabel":"Delight"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":350,"topicId":"influence","topicLabel":"Influence"},{"slug":"max-neal","name":"Max Neal","time":449.6,"topicId":"office","topicLabel":"Office"},{"slug":"paul-finch","name":"Paul Finch","time":552.6,"topicId":"building","topicLabel":"Building"},{"slug":"steve-mullin","name":"Steve Mullin","time":1239.4,"topicId":"food-and-drink","topicLabel":"Food and drink"},{"slug":"will-alsop","name":"Will Alsop","time":833.88,"topicId":"hot-stuff-club","topicLabel":"Hot Stuff Club"}]},"FUN PALACE":{"slug":"fun-palace","body":"Fun Palace is Cedric Price’s most celebrated work. Whether characterised as a giant toy or as a building-sized transformable machine, the project’s interest resides in its radical reliance on structure and technology, its exemplification of notions of time-based and anticipatory architecture. With Fun Palace, Price addressed social and political issues that go far beyond the typical bounds of architecture. Fun Palace was conceived and commissioned in 1961 by renowned theatre director and producer Joan Littlewood. Price developed plans for the project through 1964, both for the main project and for a smaller, more mobile “pilot” project. Neither were realised. Attempts to get planning permission for a wide variety of sites within and around London continued through 1970, amidst opposition from church, citizen groups and confounded city councils.","subtitle":"Laboratory of Fun and a University of the Streets","image":"/cedric-price-memory-bank/cards/fun-palace.jpg","external":"http://www.cca.qc.ca/en/collection/283-cedric-price-fun-palace","location":"https://www.google.com/maps/place/London,+UK/@51.518722,-0.0007261,13z","also":[{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":139.88,"topicId":"thinking","topicLabel":"Thinking"},{"slug":"brett-steele","name":"Brett Steele","time":464.08,"topicId":"office","topicLabel":"Office"},{"slug":"carlos-villanueva-brandt","name":"Carlos Villanueva Brandt","time":647.24,"topicId":"architecture","topicLabel":"Architecture"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":11,"topicId":"present","topicLabel":"Present"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":381,"topicId":"office","topicLabel":"Office"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":671.76,"topicId":"time","topicLabel":"Time"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":1034.84,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":1547.08,"topicId":"present","topicLabel":"Present"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":414.28,"topicId":"building","topicLabel":"Building"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1021.72,"topicId":"enabling","topicLabel":"Enabling"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1036.76,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1132.72,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"john-frazer","name":"John Frazer","time":873.92,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"john-frazer","name":"John Frazer","time":1684.84,"topicId":"thinking","topicLabel":"Thinking"},{"slug":"max-neal","name":"Max Neal","time":744.8,"topicId":"enabling","topicLabel":"Enabling"},{"slug":"max-neal","name":"Max Neal","time":796.08,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"max-neal","name":"Max Neal","time":883.28,"topicId":"influence","topicLabel":"Influence"},{"slug":"paul-finch","name":"Paul Finch","time":676.6,"topicId":"building","topicLabel":"Building"},{"slug":"paul-finch","name":"Paul Finch","time":1117.36,"topicId":"thinking","topicLabel":"Thinking"},{"slug":"paul-finch","name":"Paul Finch","time":1903.76,"topicId":"present","topicLabel":"Present"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":651.64,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"steve-mullin","name":"Steve Mullin","time":83.44,"topicId":"office","topicLabel":"Office"},{"slug":"steve-mullin","name":"Steve Mullin","time":138.8,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"steve-mullin","name":"Steve Mullin","time":637.8,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"steve-mullin","name":"Steve Mullin","time":681.84,"topicId":"potteries-thinkbelt","topicLabel":"POTTERIES THINKBELT"},{"slug":"steve-mullin","name":"Steve Mullin","time":1943.6,"topicId":"drawing","topicLabel":"Drawing"},{"slug":"will-alsop","name":"Will Alsop","time":1104.36,"topicId":"fun-palace","topicLabel":"FUN PALACE"}]},"Hot Stuff Club":{"slug":"hot-stuff-club","body":"Price chose his company with care. He founded the Hot Stuff Club in 1970, but is reluctant to discuss its activities. Few architects have been granted membership of this exclusive cabal, characterised by its eccentric sartorial and dietary rules (members were given badges made from the caps of old-fashioned mustard pots and mustard was always on the table at meetings) and encouragement of witty conversation and wicked gossip. Price had architect friends, Norman Foster, for example, and former assistant Will Alsop, \"but we rarely talk about architecture\".","subtitle":"“Exclusive Cabal”","image":null,"external":"http://www.telegraph.co.uk/culture/4708428/Think-the-unimaginable.html","location":"https://maps.google.com/?q=London,+UK","also":[{"slug":"paul-finch","name":"Paul Finch","time":54.36,"topicId":"network","topicLabel":"Network"},{"slug":"steve-mullin","name":"Steve Mullin","time":1205.88,"topicId":"network","topicLabel":"Network"},{"slug":"will-alsop","name":"Will Alsop","time":815.88,"topicId":"hot-stuff-club","topicLabel":"Hot Stuff Club"}]},"InterAction Centre":{"slug":"interaction-centre","body":"The failure of the Fun Palace was not the end of Price's attempts to realize an interactive and improvisational architecture. In 1976, he built a greatly reduced version of the Fun Palace in Kentish Town. Known as the InterAction Centre, this design incorporated many of the features and innovations of the Fun Palace, though on a smaller scale. It was demolished in 2003.","subtitle":"Kentish Town","image":"/cedric-price-memory-bank/cards/interaction-centre.jpg","external":"http://www.audacity.org/SM-26-11-07-02.htm","location":"https://www.google.com/maps/place/Kentish+Town/@51.55031,-0.14071,14z","also":[{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":500.68,"topicId":"thinking","topicLabel":"Thinking"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":411.76,"topicId":"building","topicLabel":"Building"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":580.12,"topicId":"interaction-centre","topicLabel":"INTERACTION CENTRE"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1022.52,"topicId":"enabling","topicLabel":"Enabling"},{"slug":"paul-finch","name":"Paul Finch","time":632.24,"topicId":"building","topicLabel":"Building"},{"slug":"peter-murray","name":"Peter Murray","time":1300.44,"topicId":"enabling","topicLabel":"Enabling"},{"slug":"will-alsop","name":"Will Alsop","time":15.88,"topicId":"interaction-centre","topicLabel":"INTERACTION CENTRE"}]},"Joan Littlewood":{"slug":"joan-littlewood","body":"Joan Maud Littlewood (6 October 1914 – 20 September 2002) was an English theatre director, best known for her work in developing the left-wing <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Theatre_Workshop\">Theatre Workshop</a>. She has been called \"The Mother of Modern Theatre\". Littlewood and her company lived and slept in the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Theatre_Royal_Stratford_East\">Theatre Royal</a> while it was restored. Productions of <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/The_Alchemist_(play)\">The Alchemist</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Richard_II_(play)\">Richard II</a>, the latter starring <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Harry_H._Corbett\">Harry H. Corbett</a> in the title role, established the reputation of the company. She also conceived and developed the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/w/index.php?title=Fun_Palace&amp;action=edit&amp;redlink=1\">Fun Palace</a> in collaboration with architect <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Cedric_Price\">Cedric Price</a>, an experimental model of a participatory social environment that, although never realized, has become an important influence in the architecture of the 20th and 21st centuries.","subtitle":"Theatre Director","image":"/cedric-price-memory-bank/cards/joan-littlewood.jpg","external":"http://en.wikipedia.org/wiki/Joan_Littlewood","location":"https://www.google.com/maps/place/United+Kingdom/@55.3617609,-3.4433238,5z","also":[{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":395.96,"topicId":"office","topicLabel":"Office"},{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":1096.72,"topicId":"institutions","topicLabel":"Institutions"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":418.72,"topicId":"building","topicLabel":"Building"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1044.16,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"john-frazer","name":"John Frazer","time":928.16,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"max-neal","name":"Max Neal","time":408.16,"topicId":"office","topicLabel":"Office"},{"slug":"paul-finch","name":"Paul Finch","time":32.56,"topicId":"network","topicLabel":"Network"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":727.36,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"will-alsop","name":"Will Alsop","time":1102.68,"topicId":"fun-palace","topicLabel":"FUN PALACE"}]},"La Villette Greenhouse":{"slug":"la-villette-greenhouse","body":"SERRE is a proposal for a greenhouse located in the Parc de la Villette in Paris, north of the canal de l’Ourq and adjacent to the lock on the canal de st. Denis. (Opera, p. 10)\r\n\r\nPaul Finch: There was an intriguing moment where it looked like Cedric Price might do some sort of pavilion at La Villette. It was designed with Frank Newby engineers – quite a substantial job – but I got the impression that the budgets were starting to be trimmed and it was never realised.\r\n\r\nBernard Tschumi: This is exactly what happened. Being the chief architect of the whole operation, I had asked a few people to design something. In the case of Cedric it was a pretty substantial greenhouse and he had worked quite seriously on it, but it had to be financed by both public and private money, and as the private money never came, it was never done. You might be amused to know that in the new Paris Zoo I just completed, the greenhouse is a sort of silent homage to that very one designed by Cedric.","subtitle":null,"image":null,"external":null,"location":null,"also":[{"slug":"bernard-tschumi","name":"Bernard Tschumi","time":542.6,"topicId":"vilette","topicLabel":"VILETTE"},{"slug":"max-neal","name":"Max Neal","time":207.6,"topicId":"building","topicLabel":"Building"},{"slug":"paul-finch","name":"Paul Finch","time":526.28,"topicId":"building","topicLabel":"Building"},{"slug":"will-alsop","name":"Will Alsop","time":421.56,"topicId":"building","topicLabel":"Building"}]},"Labour Party":{"slug":"labour-party","body":"The Labour Party is a <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Centre-left\">centre-left</a> political party in the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/United_Kingdom\">United Kingdom</a>. It grew out of the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Labour_movement\">trade union movement</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Socialism\">socialist</a> political parties of the nineteenth century and has been described as a <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Broad_church\">broad church</a>; the party contains a diversity of ideological trends from strongly socialist, to more moderately <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Social_democracy\">social democratic</a>.","subtitle":"Political party","image":"/cedric-price-memory-bank/cards/labour-party.jpg","external":"http://www.labour.org.uk","location":"https://maps.google.com/?q=UK","also":[{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":223.48,"topicId":"delight","topicLabel":"Delight"},{"slug":"max-neal","name":"Max Neal","time":655,"topicId":"network","topicLabel":"Network"},{"slug":"peter-murray","name":"Peter Murray","time":1030.72,"topicId":"network","topicLabel":"Network"},{"slug":"will-alsop","name":"Will Alsop","time":1239.44,"topicId":"fun-palace","topicLabel":"FUN PALACE"}]},"McAlpine (company)":{"slug":"mcalpine-company","body":"Sir Robert McAlpine is a private British company headquartered in Hertfordshire. It carries out engineering and construction for the oil and gas, petrochemical, power generation, nuclear, pharmaceutical, defence, chemical, water and mining industries.","subtitle":null,"image":null,"external":null,"location":null,"also":[{"slug":"max-neal","name":"Max Neal","time":235.36,"topicId":"building","topicLabel":"Building"},{"slug":"max-neal","name":"Max Neal","time":412.8,"topicId":"office","topicLabel":"Office"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":886.44,"topicId":"mcappy","topicLabel":"McAPPY"},{"slug":"will-alsop","name":"Will Alsop","time":602.56,"topicId":"mcappy","topicLabel":"McAPPY"}]},"McAppy":{"slug":"mcappy","body":"<span lang=\"EN-GB\"><ins cite=\"mailto:Samantha%20McLean\" datetime=\"2011-04-14T11:29\">McAppy experimented with the ability of an architectural office to deal with a truly diverse problematic, namely the unhealthy work environment of construction sites in Great Britain in the 1960’s and 70’s.</ins></span>","subtitle":"Cedric Price Office","image":"/cedric-price-memory-bank/cards/mcappy.jpg","external":"http://en.wikipedia.org/wiki/Alistair_McAlpine,_Baron_McAlpine_of_West_Green","location":"https://www.google.com/maps/search/world/@43.5352393,5.724524,2z","also":[{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":847.56,"topicId":"mcappy","topicLabel":"McAPPY"},{"slug":"will-alsop","name":"Will Alsop","time":607.68,"topicId":"mcappy","topicLabel":"McAPPY"},{"slug":"will-alsop","name":"Will Alsop","time":1260.8,"topicId":"mcappy","topicLabel":"McAPPY"}]},"Pompidou Centre":{"slug":"pompidou-centre","body":"Centre Georges Pompidou commonly shortened to Centre Pompidou; also known as the Pompidou Centre in English) is a complex building in the Beaubourg area of the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/4th_arrondissement_of_Paris\">4th arrondissement</a> of Paris, near <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Les_Halles\">Les Halles</a>, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Rue_Montorgueil\">rue Montorgueil</a> and the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Le_Marais\">Marais</a>. It was by the architectural team of <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Richard_Rogers\">Richard Rogers</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Renzo_Piano\">Renzo Piano</a>, along with <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Gianfranco_Franchini\">Gianfranco Franchini</a>.","subtitle":null,"image":null,"external":null,"location":null,"also":[{"slug":"john-frazer","name":"John Frazer","time":949.4,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"max-neal","name":"Max Neal","time":879.52,"topicId":"influence","topicLabel":"Influence"},{"slug":"will-alsop","name":"Will Alsop","time":1157.08,"topicId":"fun-palace","topicLabel":"FUN PALACE"}]},"Renzo Piano":{"slug":"renzo-piano","body":"Renzo Piano, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Order_of_Merit_of_the_Italian_Republic\">Cavaliere di Gran Croce OMRI</a> (born 14 September 1937) is an <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Italy\">Italian</a><a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Pritzker_Architecture_Prize\">Pritzker Prize</a>-winning <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Architect\">architect</a>. In 2006, Piano was selected by <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Time_(magazine)\">TIME</a> as one of the 100 most influential people in the world. He was selected as the 10th most influential person in the \"Arts and Entertainment\" category of the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/2006_Time_100\">2006 Time 100</a>. In August 2013 he was appointed <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Senator_for_Life\">Senator for Life</a> in the Italian Senate by President <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Giorgio_Napolitano\">Giorgio Napolitano</a>.","subtitle":"Architect","image":"/cedric-price-memory-bank/cards/renzo-piano.jpg","external":"http://www.rpbw.com","location":"https://www.google.com/maps/place/United+Kingdom/@55.3617609,-3.4433238,5z","also":[{"slug":"brett-steele","name":"Brett Steele","time":328.92,"topicId":"influence","topicLabel":"Influence"},{"slug":"will-alsop","name":"Will Alsop","time":1175.68,"topicId":"fun-palace","topicLabel":"FUN PALACE"}]},"Richard Meier":{"slug":"richard-meier","body":"Richard Meier (born October 12, 1934) is an American <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Abstract_art\">abstract artist</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Architect\">architect</a>, whose geometric designs make prominent use of the color white. A winner of the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Pritzker_Architecture_Prize\">Pritzker Architecture Prize</a> in 1984, some of his more iconic buildings include the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Barcelona_Museum_of_Contemporary_Art\">Barcelona Museum of Contemporary Art</a> and the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Getty_Center\">Getty Center</a> in <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Los_Angeles\">Los Angeles</a>.","subtitle":"Architect","image":"/cedric-price-memory-bank/cards/richard-meier.jpg","external":"http://www.richardmeier.com","location":"https://www.google.com/maps/place/475+10th+Ave,+New+York,+NY+10018,+USA/@40.7562375,-73.9984038,17z","also":[{"slug":"will-alsop","name":"Will Alsop","time":1092.64,"topicId":"personality","topicLabel":"Personality"}]},"Richard Rogers":{"slug":"richard-rogers","body":"Richard Rogers is a British architect noted for his <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Modernist\">modernist</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Functionalism_(architecture)\">functionalist</a> designs in <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/High-tech_architecture\">high-tech architecture</a>. Rogers is perhaps best known for his work on the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Centre_Georges_Pompidou\">Pompidou Centre</a> in Paris, the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Lloyd%27s_building\">Lloyd's building</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Millennium_Dome\">Millennium Dome</a> both in London, the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Senedd\">Senedd</a> in <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Cardiff\">Cardiff</a>, and the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/European_Court_of_Human_Rights_building\">European Court of Human Rights building</a> in Strasbourg. He is a winner of the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Royal_Gold_Medal\">RIBA Gold Medal</a>, the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Thomas_Jefferson_Foundation_Medal_in_Architecture\">Thomas Jefferson Medal</a>, the RIBA <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Stirling_Prize\">Stirling Prize</a>, the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Chartered_Society_of_Designers\">Minerva Medal</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Pritzker_Prize\">Pritzker Prize</a>.","subtitle":"Richard George Rogers, Baron Rogers of Riverside","image":"/cedric-price-memory-bank/cards/richard-rogers.jpg","external":"http://www.rsh-p.com/rshp_home","location":"https://maps.google.com/?q=Rogers+Stirk+Harbour+++Partners","also":[{"slug":"brett-steele","name":"Brett Steele","time":328.88,"topicId":"influence","topicLabel":"Influence"},{"slug":"john-frazer","name":"John Frazer","time":969.4,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"max-neal","name":"Max Neal","time":841.52,"topicId":"fun-palace","topicLabel":"FUN PALACE"},{"slug":"max-neal","name":"Max Neal","time":864.28,"topicId":"influence","topicLabel":"Influence"},{"slug":"will-alsop","name":"Will Alsop","time":1174.04,"topicId":"fun-palace","topicLabel":"FUN PALACE"}]},"Smarties":{"slug":"smarties","body":"Smarties are a colour-varied sugar-coated <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Chocolate\">chocolate</a><a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Confectionery\">confectionery</a>. Smarties are one of Britain’s best-loved brands. There are eight colours to choose from; red, orange, blue, green, yellow, pink, violet and brown. The orange Smartie is flavoured with natural orange oil. They have been manufactured since 1937, originally by <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Rowntree%27s\">H.I. Rowntree &amp; Company</a>. They are currently produced by <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Nestl%C3%A9\">Nestlé</a>.","subtitle":"Chocolate confectionery","image":"/cedric-price-memory-bank/cards/smarties.jpg","external":"http://www.nestle.co.uk/brands/chocolate_and_confectionery/chocolate/smarties","location":"https://maps.google.com/?q=UK","also":[{"slug":"will-alsop","name":"Will Alsop","time":874.8,"topicId":"office","topicLabel":"Office"}]},"The White Room":{"slug":"the-white-room","body":"Cedric Price’s famous all-white room, located at the top of an Edwardian building in Alfred Place, just off Tottenham Court Road in London, was sparsely furnished - just a couple of chairs and a desk, on which stands an Anglepoise lamp, an ashtray and a decanter of brandy. As you toiled up the stairs you pass notices - \"Wipe your feet!\" and (on the next landing) \"And again!\". The all-white room is not just a bolt-hole where the famously sociable Price retires to think and smoke one of his favourite cigars: it was a power-house of radical ideas.\r\n<p class=\"MsoNormal\" style=\"margin-right: 53.5pt; tab-stops: 0in;\"></p>","subtitle":"CP Office","image":null,"external":"http://www.telegraph.co.uk/culture/4708428/Think-the-unimaginable.html","location":"https://maps.google.com/?q=38+Alfred+Pl,+London+WC1E,+UK","also":[{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1639.64,"topicId":"food-and-drink","topicLabel":"Food and drink"},{"slug":"jeremy-melvin","name":"Jeremy Melvin","time":1750.04,"topicId":"office","topicLabel":"Office"},{"slug":"max-neal","name":"Max Neal","time":388.44,"topicId":"office","topicLabel":"Office"},{"slug":"paul-barker","name":"Paul Barker","time":1136.04,"topicId":"office","topicLabel":"Office"},{"slug":"peter-murray","name":"Peter Murray","time":283.72,"topicId":"personality","topicLabel":"Personality"},{"slug":"peter-murray","name":"Peter Murray","time":1046.08,"topicId":"network","topicLabel":"Network"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":213.96,"topicId":"office","topicLabel":"Office"},{"slug":"samantha-hardingham","name":"Samantha Hardingham","time":470.36,"topicId":"office","topicLabel":"Office"},{"slug":"will-alsop","name":"Will Alsop","time":577.76,"topicId":"office","topicLabel":"Office"},{"slug":"will-alsop","name":"Will Alsop","time":877.08,"topicId":"office","topicLabel":"Office"}]},"Trade Union Congress":{"slug":"trade-union-congress","body":"The Trades Union Congress (TUC) is a <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/National_trade_union_center\">national trade union centre</a>, a federation of <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Trade_union\">trade unions</a> in <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/England_and_Wales\">England and Wales</a>, representing the majority of trade unions. There are fifty-eight affiliated unions with a total of about 6.2 million members, around half of whom are represented by <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Unite_the_Union\">Unite</a> or <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/UNISON\">UNISON</a>.","subtitle":"Trade Union Centre","image":null,"external":"http://www.tuc.org.uk","location":"https://maps.google.com/?q=Uk","also":[{"slug":"hans-ulrich-obrist","name":"Hans Ulrich Obrist","time":363,"topicId":"office","topicLabel":"Office"},{"slug":"paul-barker","name":"Paul Barker","time":1174.2,"topicId":"office","topicLabel":"Office"},{"slug":"paul-finch","name":"Paul Finch","time":646.56,"topicId":"building","topicLabel":"Building"},{"slug":"will-alsop","name":"Will Alsop","time":841.44,"topicId":"hot-stuff-club","topicLabel":"Hot Stuff Club"}]},"Vienna University of Technology":{"slug":"vienna-university-of-technology","body":"The Vienna University of Technology is one of the major universities in <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Vienna\">Vienna</a>, the capital of Austria. Founded in 1815 as the \"Imperial-Royal Polytechnic Institute\", it currently has about 26,200 students (19% foreign students/30% women), eight faculties and about 4,000 staff members (1,800 academics). The university's teaching and research is focused on <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Engineering\">engineering</a> and <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Natural_science\">natural sciences</a>.","subtitle":"Technische Universität Wien","image":"/cedric-price-memory-bank/cards/vienna-university-of-technology.jpg","external":"http://www.tuwien.ac.at/en/tuwien_home/","location":"https://www.google.com/maps/place/Vienna+University+of+Technology/@48.198655,16.368463,17z","also":[{"slug":"will-alsop","name":"Will Alsop","time":1328.16,"topicId":"conscience","topicLabel":"Conscience"}]}}}